msgstr "Eraikia"

#: admin/class-babilim-translations-table.php:590
msgid "Bulk actions apply only to the selected language of each selected component."
msgstr "Ekintza masiboak hautatutako osagai bakoitzaren hautatutako hizkuntzari soilik aplikatzen zaizkio."

#: admin/class-babilim-translations-table.php:589
msgid "Bulk actions apply to every matching language of each selected component."
msgstr "Ekintza masiboak hautatutako osagai bakoitzaren bat datozen hizkuntza guztiei aplikatzen zaizkie."

#: admin/class-babilim-admin.php:3218
msgid "Bulk download:"
msgstr "Deskarga masiboa:"

#: admin/class-babilim-admin.php:3222
