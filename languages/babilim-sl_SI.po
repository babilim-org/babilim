msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Dopolni manjkajoče prevode za vtičnike in teme, ki so že nameščeni na vašem spletišču."

#: admin/class-babilim-admin.php:1274
msgid "That upload screen was out of date: a different upload has been prepared since. Nothing was sent. Review the current one from the Translations list."
msgstr "Ta zaslon za nalaganje je bil zastarel: medtem je bilo pripravljeno drugo nalaganje. Nič ni bilo poslano. Trenutno nalaganje preglejte v razdelku Seznam prevodov."

#: admin/class-babilim-admin.php:3067
msgid "The free service plan gives each site a limited number of slots for plugins and themes; the slots in use are shown in Settings after you enable Babilim."
msgstr "Brezplačni paket storitve omogoča vsakemu spletišču omejeno število mest za vtičnike in teme; mesta v uporabi so prikazana v Nastavitvah, ko omogočite Babilim."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:62
#, php-format
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site (the limit is %1$d for themes and %2$d for plugins), unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Z zahtevo za prevod bo ta vtičnik ali tema zasedel eno od mest brezplačnega paketa storitve za to spletišče (omejitev je %1$d za teme in %2$d za vtičnike), razen če ga že zaseda. Mesto ostane zasedeno, neuspel prevod pa ga ne sprosti."

#: admin/class-babilim-translations-table.php:67
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site, unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Z zahtevo za prevod bo ta vtičnik ali tema zasedel eno od mest brezplačnega paketa storitve za to spletišče, razen če ga že zaseda. Mesto ostane zasedeno, neuspel prevod pa ga ne sprosti."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:80
#, php-format
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one (the limit is %1$d for themes and %2$d for plugins). A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Če ta vtičnik ali tema še ne zaseda enega od mest brezplačnega paketa storitve za to spletišče, ga bo z zahtevo za prevod zasedel (omejitev je %1$d za teme in %2$d za vtičnike). Mesto ostane zasedeno, neuspel prevod pa ga ne sprosti. Želite nadaljevati?"

#: admin/class-babilim-translations-table.php:85
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one. A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Če ta vtičnik ali tema še ne zaseda enega od mest brezplačnega paketa storitve za to spletišče, ga bo z zahtevo za prevod zasedel. Mesto ostane zasedeno, neuspel prevod pa ga ne sprosti. Želite nadaljevati?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1974
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d spletišče v tem omrežju je nastavljeno tako, da ob izbrisu vtičnika izbriše svojo identiteto Babilim. Plačljive licence, vezane na to spletišče, potem ni mogoče samodejno obnoviti; obrniti se boste morali na podporo Babilim na %2$s. Če želite ohraniti identiteto, pritisnite Prekliči, odstranite kljukico pri \"Ob odstranitvi izbriši vse podatke Babilim\" v nastavitvah Babilim tega spletišča in znova deaktivirajte. Vseeno deaktiviram?"
msgstr[1] "%1$d spletišči v tem omrežju sta nastavljeni tako, da ob izbrisu vtičnika izbrišeta svojo identiteto Babilim. Plačljivih licenc, vezanih na ti spletišči, potem ni mogoče samodejno obnoviti; obrniti se boste morali na podporo Babilim na %2$s. Če želite ohraniti identiteti, pritisnite Prekliči, odstranite kljukico pri \"Ob odstranitvi izbriši vse podatke Babilim\" v nastavitvah Babilim vsakega spletišča in znova deaktivirajte. Vseeno deaktiviram?"
msgstr[2] "%1$d spletišča v tem omrežju so nastavljena tako, da ob izbrisu vtičnika izbrišejo svojo identiteto Babilim. Plačljivih licenc, vezanih na ta spletišča, potem ni mogoče samodejno obnoviti; obrniti se boste morali na podporo Babilim na %2$s. Če želite ohraniti identitete, pritisnite Prekliči, odstranite kljukico pri \"Ob odstranitvi izbriši vse podatke Babilim\" v nastavitvah Babilim vsakega spletišča in znova deaktivirajte. Vseeno deaktiviram?"
msgstr[3] "%1$d spletišč v tem omrežju je nastavljenih tako, da ob izbrisu vtičnika izbrišejo svojo identiteto Babilim. Plačljivih licenc, vezanih na ta spletišča, potem ni mogoče samodejno obnoviti; obrniti se boste morali na podporo Babilim na %2$s. Če želite ohraniti identitete, pritisnite Prekliči, odstranite kljukico pri \"Ob odstranitvi izbriši vse podatke Babilim\" v nastavitvah Babilim vsakega spletišča in znova deaktivirajte. Vseeno deaktiviram?"

