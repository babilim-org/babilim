msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Dopołnijo felujuce pśełožki za tykace a drastwy, kótarež su južo na twójom sedle instalěrowane."

#: admin/class-babilim-admin.php:1274
msgid "That upload screen was out of date: a different upload has been prepared since. Nothing was sent. Review the current one from the Translations list."
msgstr "Toś ten wobraz za nagraśe jo był zestarjony: pózdźej jo se druge nagraśe pśigótowało. Nic njejo se pósłało. Pśeglědaj aktualne nagraśe z Lisćiny pśełožkow."

#: admin/class-babilim-admin.php:3067
msgid "The free service plan gives each site a limited number of slots for plugins and themes; the slots in use are shown in Settings after you enable Babilim."
msgstr "Licha słužbowa pakšyna dajo kuždemu sedłoju wobgranicowanu licbu městnow za tykace a drastwy; wužywane městna se w nastajenjach pokazuju, gaž Babilim zmóžnijoš."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:62
#, php-format
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site (the limit is %1$d for themes and %2$d for plugins), unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Gaž pśełožk pominaš, se toś ten tykac abo toś ta drastwa pśipokazujo na jadno z městnow licheje słužboweje pakšyny za toś to sedło (limit jo %1$d za drastwy a %2$d za tykace), mimo gaž južo jadno městno ma. Městno wóstanjo wužywane a njewuspěšny pśełožk jo njewóswobóźijo."

#: admin/class-babilim-translations-table.php:67
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site, unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Gaž pśełožk pominaš, se toś ten tykac abo toś ta drastwa pśipokazujo na jadno z městnow licheje słužboweje pakšyny za toś to sedło, mimo gaž južo jadno městno ma. Městno wóstanjo wužywane a njewuspěšny pśełožk jo njewóswobódźijo."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:80
#, php-format
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one (the limit is %1$d for themes and %2$d for plugins). A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Jolic toś ten tykac abo toś ta drastwa hyšći njejo na jadnom z městnow licheje słužboweje pakšyny za toś to sedło, se z pominanim pśełožka na jadno městno pśipokazujo (limit jo %1$d za drastwy a %2$d za tykace). Městno wóstanjo wužywane a njewuspěšny pśełožk jo njewóswobódźijo. Pókšacowaś?"

#: admin/class-babilim-translations-table.php:85
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one. A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Jolic toś ten tykac abo toś ta drastwa hyšći njejo na jadnom z městnow licheje słužboweje pakšyny za toś to sedło, se z pominanim pśełožka na jadno městno pśipokazujo. Městno wóstanjo wužywane a njewuspěšny pśełožk jo njewóswobódźijo. Pókšacowaś?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1974
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d sedło w toś tej sieśi jo nastajone, aby swóju identitu Babilim wulašowało, gaž se tykac wulašujo. Płaśona licenca, kótaraž jo z tym sedłom zwězana, njedajo se pótom awtomatiski wobnowiś; musyśo se na Pomoc Babilim na %2$s wobrośiś. Aby identitu zachowali, klikniśo na Pśetergnuś, wótwólśo kokulku pód „Wšykne Babilim-daty pśi wótinstalěrowanju lašowaś“ w nastajenjach Babilim toś togo sedła a deaktiwěrujśo hyšći raz. Tekrajkuli deaktiwěrowaś?"
msgstr[1] "%1$d sedle w toś tej sieśi stej nastajonej, aby swóju identitu Babilim wulašowałej, gaž se tykac wulašujo. Płaśona licenca, kótaraž jo z tymaž sedloma zwězana, njedajo se pótom awtomatiski wobnowiś; musyśo se na Pomoc Babilim na %2$s wobrośiś. Aby identitu zachowali, klikniśo na Pśetergnuś, wótwólśo kokulku pód „Wšykne Babilim-daty pśi wótinstalěrowanju lašowaś“ w nastajenjach Babilim kuždego sedła a deaktiwěrujśo hyšći raz. Tekrajkuli deaktiwěrowaś?"
msgstr[2] "%1$d sedła w toś tej sieśi su nastajone, aby swóju identitu Babilim wulašowali, gaž se tykac wulašujo. Płaśona licenca, kótaraž jo z tymi sedłami zwězana, njedajo se pótom awtomatiski wobnowiś; musyśo se na Pomoc Babilim na %2$s wobrośiś. Aby identity zachowali, klikniśo na Pśetergnuś, wótwólśo kokulku pód „Wšykne Babilim-daty pśi wótinstalěrowanju lašowaś“ w nastajenjach Babilim kuždego sedła a deaktiwěrujśo hyšći raz. Tekrajkuli deaktiwěrowaś?"
msgstr[3] "%1$d sedłow w toś tej sieśi jo nastajonych, aby swóju identitu Babilim wulašowali, gaž se tykac wulašujo. Płaśona licenca, kótaraž jo z tymi sedłami zwězana, njedajo se pótom awtomatiski wobnowiś; musyśo se na Pomoc Babilim na %2$s wobrośiś. Aby identity zachowali, klikniśo na Pśetergnuś, wótwólśo kokulku pód „Wšykne Babilim-daty pśi wótinstalěrowanju lašowaś“ w nastajenjach Babilim kuždego sedła a deaktiwěrujśo hyšći raz. Tekrajkuli deaktiwěrowaś?"

