msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Melengkapkan terjemahan yang tiada untuk pemalam dan tema yang sudah dipasang pada tapak anda."

#: admin/class-babilim-admin.php:335
#: admin/class-babilim-admin.php:336
#: admin/class-babilim-translations-table.php:400
msgid "Translations"
msgstr "Terjemahan"

#: admin/class-babilim-admin.php:343
msgid "Babilim Settings"
msgstr "Tetapan Babilim"

#: admin/class-babilim-admin.php:344
#: admin/class-babilim-admin.php:2557
#: admin/class-babilim-admin.php:2846
msgid "Settings"
msgstr "Tetapan"

#: admin/class-babilim-admin.php:371
#: admin/class-babilim-admin.php:779
msgid "You are not allowed to do this."
msgstr "Anda tidak dibenarkan melakukan tindakan ini."

#. translators: 1: the most operations one run accepts, 2: how many were selected.
#: admin/class-babilim-admin.php:400
#, php-format
msgid "Select fewer components: at most %1$d operations per run (you selected %2$d)."
msgstr "Pilih lebih sedikit komponen: paling banyak %1$d operasi bagi setiap larian (anda memilih %2$d)."

#: admin/class-babilim-admin.php:413
#: admin/class-babilim-admin.php:1132
#: admin/class-babilim-admin.php:1303
msgid "That component is not installed on this site, so a translation cannot be requested for it."
msgstr "Komponen itu tidak dipasang pada tapak ini, jadi terjemahan tidak boleh dimohon untuknya."

#: admin/class-babilim-admin.php:933
msgid "Already installed."
msgstr "Sudah dipasang."

#: admin/class-babilim-admin.php:933
msgid "Downloaded and installed."
msgstr "Dimuat turun dan dipasang."

#: admin/class-babilim-admin.php:956
#: admin/class-babilim-admin.php:1297
#: admin/class-babilim-admin.php:1373
#: admin/class-babilim-admin.php:1951
#: admin/class-babilim-admin.php:2115
#: includes/class-babilim-api-client.php:520
#: includes/class-babilim-site.php:311
#: includes/class-babilim-site.php:362
#: includes/class-babilim-site.php:705
#: includes/class-babilim-site.php:838
msgid "Babilim has not been enabled for this site yet."
msgstr "Babilim belum didayakan untuk tapak ini."

#: admin/class-babilim-admin.php:975
msgid "No build is available to download for this locale."
msgstr "Tiada binaan tersedia untuk dimuat turun bagi lokal ini."

#: admin/class-babilim-admin.php:1030
msgid "Rolled back to the previous build."
msgstr "Dikembalikan kepada binaan sebelumnya."

#: admin/class-babilim-admin.php:1089
msgid "Rolled back and reported."
msgstr "Dikembalikan dan dilaporkan."

#. translators: %s: why sending the report failed.
#: admin/class-babilim-admin.php:1095
#, php-format
msgid "Rolled back, but the report could not be sent: %s"
msgstr "Dikembalikan, tetapi laporan tidak dapat dihantar: %s"

#: admin/class-babilim-admin.php:1119
msgid "Removed."
msgstr "Dialih keluar."

#: admin/class-babilim-admin.php:1155
msgid "Translation requested."
msgstr "Terjemahan diminta."

#: admin/class-babilim-admin.php:1177
msgid "This component was already uploaded. Babilim is checking it now."
msgstr "Komponen ini telah dimuat naik. Babilim sedang menyemaknya sekarang."

#: admin/class-babilim-admin.php:1217
msgid "Upload cancelled."
msgstr "Muat naik dibatalkan."

#: admin/class-babilim-admin.php:1228
msgid "Upload complete — translation requested."
msgstr "Muat naik selesai — terjemahan diminta."

#: admin/class-babilim-admin.php:1306
msgid "This component does not declare a version number, so a translation cannot be requested for it."
msgstr "Komponen ini tidak mengisytiharkan nombor versi, jadi terjemahan tidak boleh dimohon untuknya."

#. translators: %d: the most characters a version number may have.
#: admin/class-babilim-admin.php:1313
#, php-format
msgid "This component's version number is longer than %d characters, which Babilim cannot handle, so a translation cannot be requested for it."
msgstr "Nombor versi komponen ini melebihi %d aksara, yang tidak dapat dikendalikan oleh Babilim, jadi terjemahan tidak boleh dimohon untuknya."

#: admin/class-babilim-admin.php:1319
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "Terjemahan tidak boleh dimohon untuk lokal itu pada tapak ini buat masa ini."

#: admin/class-babilim-admin.php:1345
msgid "Thank you. Your report was sent."
msgstr "Terima kasih. Laporan anda telah dihantar."

#: admin/class-babilim-admin.php:1378
msgid "This report does not name a valid plugin or theme and locale."
msgstr "Laporan ini tidak menamakan pemalam atau tema dan lokal yang sah."

#: admin/class-babilim-admin.php:1382
msgid "Please choose a category for this report."
msgstr "Sila pilih kategori untuk laporan ini."

#: admin/class-babilim-admin.php:1386
msgid "This report is missing a valid build to report against."
msgstr "Laporan ini tiada binaan sah untuk dilaporkan."

#: admin/class-babilim-admin.php:1389
msgid "This build is not one this site currently knows about for this component/locale."
msgstr "Binaan ini bukan binaan yang dikenali oleh tapak ini buat masa ini untuk komponen/lokal ini."

#. translators: 1: the name of a form field, 2: how many characters it has, 3: the most characters it may have.
#: admin/class-babilim-admin.php:1441
#, php-format
msgid "The field \"%1$s\" is too long: it has %2$d characters and the limit is %3$d. Nothing was sent; please shorten it and try again."
msgstr "Medan \"%1$s\" terlalu panjang: ia mempunyai %2$d aksara dan had ialah %3$d. Tiada apa-apa dihantar; sila pendekkan dan cuba lagi."

#: admin/class-babilim-admin.php:1466
msgid "Original string"
msgstr "Rentetan asal"

#: admin/class-babilim-admin.php:1470
msgid "String context"
msgstr "Konteks rentetan"

#: admin/class-babilim-admin.php:1474
#: admin/class-babilim-admin.php:4067
msgid "Current translation"
msgstr "Terjemahan semasa"

#: admin/class-babilim-admin.php:1478
#: admin/class-babilim-admin.php:4069
msgid "Suggested translation"
msgstr "Terjemahan dicadangkan"

#: admin/class-babilim-admin.php:1482
#: admin/class-babilim-admin.php:4071
msgid "Note (optional)"
msgstr "Nota (pilihan)"

#: admin/class-babilim-admin.php:1486
#: admin/class-babilim-admin.php:4073
msgid "Where you saw this (optional)"
msgstr "Di mana anda melihat ini (pilihan)"

#. translators: %s: the date and time syncing is expected to resume.
#: admin/class-babilim-admin.php:1549
#, php-format
msgid "Babilim sync is temporarily delayed by the service (rate limited); it will try again after %s."
msgstr "Penyegerakan Babilim ditangguhkan sementara oleh perkhidmatan (had kadar); ia akan mencuba lagi selepas %s."

#: admin/class-babilim-admin.php:1583
msgid "That is not a valid WordPress locale code. Nothing was saved."
msgstr "Itu bukan kod lokal WordPress yang sah. Tiada apa-apa disimpan."

#: admin/class-babilim-admin.php:1616
msgid "Settings saved."
msgstr "Tetapan disimpan."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1678
#, php-format
msgid "If this is on, uninstalling also erases this site's identity. The paid license attached to this site cannot be restored automatically afterwards; you would have to contact Babilim support at %s to get it back."
msgstr "Jika ini dihidupkan, menyahpasang juga memadam identiti tapak ini. Lesen berbayar yang dikaitkan dengan tapak ini tidak dapat dipulihkan secara automatik selepas itu; anda perlu menghubungi sokongan Babilim di %s untuk mendapatkannya semula."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1694
#, php-format
msgid "Babilim is set to erase this site's identity when the plugin is deleted. The paid license attached to this site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in the Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Babilim ditetapkan untuk memadam identiti tapak ini apabila pemalam dipadam. Lesen berbayar yang dipautkan pada tapak ini kemudiannya tidak dapat dipulihkan secara automatik; anda perlu menghubungi sokongan Babilim di %s. Untuk mengekalkan identiti, tekan Batal, nyahtanda \"Padam semua data Babilim semasa penyahpasangan\" dalam tetapan Babilim, dan nyahaktifkan semula. Nyahaktifkan juga?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1719
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d tapak dalam rangkaian ini ditetapkan untuk memadam identiti Babilim mereka apabila pemalam dipadam. Lesen berbayar yang dipautkan pada tapak tersebut kemudiannya tidak dapat dipulihkan secara automatik; anda perlu menghubungi sokongan Babilim di %2$s. Untuk mengekalkan identiti, tekan Batal, nyahtanda \"Padam semua data Babilim semasa penyahpasangan\" dalam tetapan Babilim setiap tapak, dan nyahaktifkan semula. Nyahaktifkan juga?"

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1738
#, php-format
msgid "This network has too many sites to check them one by one, and some of them may be set to erase their Babilim identity when the plugin is deleted. The paid license attached to such a site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Rangkaian ini mempunyai terlalu banyak tapak untuk disemak satu persatu, dan sesetengahnya mungkin ditetapkan untuk memadam identiti Babilim apabila pemalam dipadam. Lesen berbayar yang dipautkan pada tapak sedemikian kemudiannya tidak dapat dipulihkan secara automatik; anda perlu menghubungi sokongan Babilim di %s. Untuk mengekalkan identiti, tekan Batal, nyahtanda \"Padam semua data Babilim semasa penyahpasangan\" dalam tetapan Babilim setiap tapak, dan nyahaktifkan semula. Nyahaktifkan juga?"

#: admin/class-babilim-admin.php:1827
msgid "Open Babilim settings"
msgstr "Buka tetapan Babilim"

#: admin/class-babilim-admin.php:1832
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Babilim tidak dapat mengesahkan tapak ini, jadi tiada apa-apa dimuat turun atau dipasang."

#: admin/class-babilim-admin.php:1844
msgid "The service could not reach your site. A firewall, security plugin or host rule is probably blocking the request; please allow requests to /wp-json/babilim/v1/challenge."
msgstr "Perkhidmatan tidak dapat mencapai tapak anda. Tembok api, pemalam keselamatan atau peraturan hos mungkin menyekat permintaan; sila benarkan permintaan ke /wp-json/babilim/v1/challenge."

#: admin/class-babilim-admin.php:1846
msgid "Your site took too long to answer. Please try again later, and check that your host is not too slow or overloaded."
msgstr "Tapak anda mengambil masa terlalu lama untuk menjawab. Sila cuba lagi nanti, dan semak bahawa hos anda tidak terlalu perlahan atau terlebih beban."

#: admin/class-babilim-admin.php:1848
msgid "Your site answered, but not with what was expected. The REST API may be rewritten by another plugin, or that endpoint may be cached; please exclude /wp-json/babilim/v1/challenge from caching and rewriting."
msgstr "Tapak anda membalas, tetapi bukan dengan jawapan yang dijangka. REST API mungkin ditulis semula oleh pemalam lain, atau titik akhir itu mungkin dicache; sila kecualikan /wp-json/babilim/v1/challenge daripada pencacheaan dan penulisan semula."

#: admin/class-babilim-admin.php:1850
msgid "Please check that your site can be reached from the internet, then try again."
msgstr "Sila semak bahawa tapak anda boleh dicapai dari internet, kemudian cuba lagi."

#: admin/class-babilim-admin.php:1873
msgid "Re-verify"
msgstr "Sahkan semula"

#. translators: 1: number of components left out, 2: number of locales left out.
#: admin/class-babilim-admin.php:1894
#, php-format
msgid "This site is over the size the service accepts in one sync, so some items were left out: %1$d components and %2$d locales."
msgstr "Tapak ini melebihi saiz yang diterima oleh perkhidmatan dalam satu penyegerakan, jadi beberapa item ditinggalkan: %1$d komponen dan %2$d lokal."

#: admin/class-babilim-admin.php:1923
msgid "This site is verified."
msgstr "Tapak ini telah disahkan."

#: admin/class-babilim-admin.php:1936
msgid "Registration restarted."
msgstr "Pendaftaran dimulakan semula."

#: admin/class-babilim-admin.php:1957
#: admin/class-babilim-admin.php:2031
msgid "Sync complete."
msgstr "Penyegerakan selesai."

#: admin/class-babilim-admin.php:1992
msgid "Babilim is enabling and checking this site… Reload this page or wait for the scheduled check to finish."
msgstr "Babilim sedang mendayakan dan menyemak tapak ini… Muat semula halaman ini atau tunggu semakan berjadual selesai."

#. translators: 1: short name of the step that failed, 2: the message for that failure.
#: admin/class-babilim-admin.php:1997
#, php-format
msgid "Babilim could not finish enabling (%1$s): %2$s"
msgstr "Babilim tidak dapat menyelesaikan pendayaan (%1$s): %2$s"

#: admin/class-babilim-admin.php:2002
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "Hos yang hanya melayan satu permintaan PHP pada satu masa tidak dapat melengkapkan langkah ini."

#. translators: %d: number of components found on this site.
#: admin/class-babilim-admin.php:2023
#, php-format
msgid "Babilim is enabled: this site is verified and %d component was found."
msgid_plural "Babilim is enabled: this site is verified and %d components were found."
msgstr[0] "Babilim diaktifkan: tapak ini telah disahkan dan %d komponen ditemui."

#: admin/class-babilim-admin.php:2107
msgid "Babilim is disabled. Nothing more is sent; translations already installed keep working."
msgstr "Babilim dinyahdayakan. Tiada apa-apa lagi dihantar; terjemahan yang sudah dipasang terus berfungsi."

#: admin/class-babilim-admin.php:2129
msgid "Supplementary translation index rebuilt."
msgstr "Indeks terjemahan tambahan telah dibina semula."

#. translators: %d: number of files deleted by this sweep.
#: admin/class-babilim-admin.php:2147
#, php-format
msgid "Sweep complete: %d file deleted."
msgid_plural "Sweep complete: %d files deleted."
msgstr[0] "Pembersihan selesai: %d fail dipadam."

#. translators: %d: number of components removed.
#: admin/class-babilim-admin.php:2179
#, php-format
msgid "Removed %d installed component."
msgid_plural "Removed %d installed components."
msgstr[0] "%d komponen yang dipasang telah dialih keluar."

#: admin/class-babilim-admin.php:2181
msgid "Automatic installs are now off; turn them on again in the settings if you want them."
msgstr "Pemasangan automatik kini dimatikan; hidupkannya semula dalam tetapan jika anda mahu."

#: admin/class-babilim-admin.php:2502
msgid "Babilim finds the plugins and themes on this site that have no translation for your language and installs one for each."
msgstr "Babilim mencari pemalam dan tema pada tapak ini yang tiada terjemahan untuk bahasa anda dan memasang satu untuk setiap satu."

#. translators: %s: a list of language names, joined the way the language joins lists.
#: admin/class-babilim-admin.php:2510
#, php-format
msgid "Languages found on this site: %s."
msgstr "Bahasa ditemui pada tapak ini: %s."

#: admin/class-babilim-admin.php:2515
msgid "Available translations can be installed with one click, and missing ones can be requested. After that, new translations and updates are installed automatically (on the free plan, only for plugins and themes that already use a free slot)."
msgstr "Terjemahan yang tersedia boleh dipasang dengan satu klik, dan yang tiada boleh dipohon. Selepas itu, terjemahan baharu dan kemas kini dipasang secara automatik (pada pelan percuma, hanya untuk pemalam dan tema yang sudah menggunakan slot percuma)."

#: admin/class-babilim-admin.php:2516
msgid "The free plan covers a limited number of plugins and themes; your exact quota is shown in Settings after you enable Babilim."
msgstr "Pelan percuma meliputi bilangan pemalam dan tema yang terhad; kuota tepat anda dipaparkan dalam Tetapan selepas anda mengaktifkan Babilim."

#: admin/class-babilim-admin.php:2517
msgid "What is sent when you enable Babilim"
msgstr "Apa yang dihantar apabila anda mengaktifkan Babilim"

#: admin/class-babilim-admin.php:2521
msgid "Enabling…"
msgstr "Mendayakan…"

#: admin/class-babilim-admin.php:2521
msgid "Enable Babilim"
msgstr "Aktifkan Babilim"

#: admin/class-babilim-admin.php:2522
msgid "By clicking Enable, you agree to send the information listed above to Babilim."
msgstr "Dengan mengklik Dayakan, anda bersetuju untuk menghantar maklumat yang disenaraikan di atas kepada Babilim."

#: admin/class-babilim-admin.php:2556
#: admin/class-babilim-admin.php:2604
#: admin/class-babilim-admin.php:3953
msgid "Check again now"
msgstr "Semak semula sekarang"

#. translators: %d: how many translations were installed automatically.
#: admin/class-babilim-admin.php:2571
#, php-format
msgid "Babilim installed %d translation automatically since your last visit."
msgid_plural "Babilim installed %d translations automatically since your last visit."
msgstr[0] "Babilim memasang %d terjemahan secara automatik sejak lawatan terakhir anda."

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:2597
#, php-format
msgid "Babilim is enabling and checking this site… (last attempt: %s)"
msgstr "Babilim sedang mendayakan dan menyemak tapak ini… (percubaan terakhir: %s)"

#: admin/class-babilim-admin.php:2601
msgid "Check again"
msgstr "Semak semula"

#: admin/class-babilim-admin.php:2614
msgid "No components synced yet."
msgstr "Belum ada komponen disegerakkan."

#. translators: %d: how many items succeeded.
#: admin/class-babilim-admin.php:2635
#, php-format
msgid "%d succeeded"
msgid_plural "%d succeeded"
msgstr[0] "%d berjaya"

#. translators: %d: how many items were skipped.
#: admin/class-babilim-admin.php:2639
#, php-format
msgid "%d skipped"
msgid_plural "%d skipped"
msgstr[0] "%d dilangkau"

#. translators: %d: how many items failed.
#: admin/class-babilim-admin.php:2643
#, php-format
msgid "%d failed"
msgid_plural "%d failed"
msgstr[0] "%d gagal"

#. translators: %d: how many items were not tried yet.
#: admin/class-babilim-admin.php:2647
#, php-format
msgid "%d not yet tried"
msgid_plural "%d not yet tried"
msgstr[0] "%d belum dicuba"

#. translators: 1: the "Bulk <action>:" lead-in.
#: admin/class-babilim-admin.php:2652
#, php-format
msgid "%1$s nothing to do."
msgstr "%1$s tiada apa-apa untuk dilakukan."

#. translators: 1: the "Bulk <action>:" lead-in, 2: the counts, already joined into a list.
#: admin/class-babilim-admin.php:2655
#, php-format
msgid "%1$s %2$s."
msgstr "%1$s %2$s."

#: admin/class-babilim-admin.php:2667
msgid "Bulk download:"
msgstr "Muat turun pukal:"

#: admin/class-babilim-admin.php:2669
msgid "Bulk update:"
msgstr "Kemas kini pukal:"

#: admin/class-babilim-admin.php:2671
msgid "Bulk request:"
msgstr "Permintaan pukal:"

#: admin/class-babilim-admin.php:2684
msgid "per day"
msgstr "sehari"

#: admin/class-babilim-admin.php:2698
msgid "Wrong meaning"
msgstr "Maksud salah"

#: admin/class-babilim-admin.php:2700
msgid "Wrong term"
msgstr "Istilah salah"

#: admin/class-babilim-admin.php:2702
msgid "Broken placeholder"
msgstr "Pemegang tempat rosak"

#: admin/class-babilim-admin.php:2704
msgid "Wrong for this context"
msgstr "Salah untuk konteks ini"

#: admin/class-babilim-admin.php:2706
msgid "Wrong plural form"
msgstr "Bentuk jamak salah"

#: admin/class-babilim-admin.php:2708
msgid "Negation reversed"
msgstr "Penafian diterbalikkan"

#: admin/class-babilim-admin.php:2710
msgid "Translation does not load"
msgstr "Terjemahan tidak dimuatkan"

#. translators: a problem report category: none of the other listed kinds of problem applies.
#: admin/class-babilim-admin.php:2713
msgctxt "problem report category"
msgid "Other"
msgstr "Lain-lain"

#. translators: 1: component name, 2: language name, 3: why the action failed.
#: admin/class-babilim-admin.php:2750
#, php-format
msgid "%1$s (%2$s): %3$s"
msgstr "%1$s (%2$s): %3$s"

#: admin/class-babilim-admin.php:2785
msgid "Continuing…"
msgstr "Meneruskan…"

#. translators: %d: how many operations are left.
#: admin/class-babilim-admin.php:2788
#, php-format
msgid "Continue next batch (%d left)"
msgstr "Teruskan kumpulan seterusnya (%d lagi)"

#: admin/class-babilim-admin.php:2838
msgid "Search components"
msgstr "Cari komponen"

#. translators: %s: link to the Settings page, with the text "Settings".
#: admin/class-babilim-admin.php:2845
#, php-format
msgid "These are the languages this site uses. You can change them in %s."
msgstr "Ini ialah bahasa yang digunakan oleh tapak ini. Anda boleh mengubahnya dalam %s."

#: admin/class-babilim-admin.php:2864
msgid "Upload this component?"
msgstr "Muat naik komponen ini?"

#: admin/class-babilim-admin.php:2866
#: includes/class-babilim-upload.php:96
msgid "There is no upload waiting for confirmation."
msgstr "Tiada muat naik yang menunggu pengesahan."

#: admin/class-babilim-admin.php:2866
#: admin/class-babilim-admin.php:2893
msgid "Back"
msgstr "Kembali"

#: admin/class-babilim-admin.php:2870
msgid "To translate this component, Babilim needs its source."
msgstr "Untuk menterjemah komponen ini, Babilim memerlukan sumbernya."

#. translators: 1: plugin or theme name, 2: its version number.
#: admin/class-babilim-admin.php:2872
