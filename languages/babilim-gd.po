msgstr "Cha b' urrainn do Babilim crìoch a chur air a chur an comas (%1$s): %2$s"

#: admin/class-babilim-admin.php:3792
msgid "Babilim could not finish verifying this site (the service could not reach it back). Registration is paused."
msgstr "Cha b' urrainn do Babilim crìoch a chur air dearbhadh na làraich seo (cha b' urrainn dhan t-seirbheis ceangal air ais ris an làrach). Tha an clàradh air a chur air stad."

#: includes/class-babilim-site.php:434
#: includes/class-babilim-sync-installer.php:401
msgid "Babilim could not verify this site, so nothing is downloaded or installed until verification succeeds."
msgstr "Cha b’ urrainn do Babilim an làrach seo a dhearbhadh, agus mar sin cha tèid dad a luchdadh a-nuas no a stàladh gus an soirbhich leis an dearbhadh."

#: admin/class-babilim-admin.php:2216
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Cha b' urrainn do Babilim an làrach seo a dhearbhadh, mar sin cha deach dad a luchdadh a-nuas no a stàladh."

