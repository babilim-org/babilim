#: includes/class-babilim-packager.php:110
msgid "Babilim could not confirm a temporary folder outside the website, so the component was not packaged and nothing was uploaded. Define BABILIM_TEMP_DIR in wp-config.php as a writable folder outside the web root (for example a folder next to, not inside, your site's public directory), or ask your host for one."
msgstr "Cha b’ urrainn dha Babilim pasgan sealach taobh a-muigh an làraich-lìn a dhearbhadh, mar sin cha deach a’ cho-phàirt a phacaigeadh agus cha deach dad a luchdadh suas. Mìnich BABILIM_TEMP_DIR ann an wp-config.php mar phasgan so-sgrìobhte taobh a-muigh freumh an lìn (mar eisimpleir pasgan ri taobh, seach am broinn, pasgan poblach na làraich agad), no iarr fear air an òstair agad."

#: includes/class-babilim-site.php:987
msgid "Babilim could not finish checking this site."
msgstr "Cha b’ urrainn do Babilim crìoch a chur air sgrùdadh na làraich seo."

#. translators: 1: short name of the step that failed, 2: the message for that failure.
#: admin/class-babilim-admin.php:2381
#, php-format
