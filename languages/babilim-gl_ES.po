msgstr "Babilim non puido verificar este sitio, polo que non se descargará nin se instalará nada ata que a verificación se complete correctamente."

#: admin/class-babilim-admin.php:2216
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Babilim non puido verificar este sitio, polo que non se descarga nin se instala nada."

#: admin/class-babilim-admin.php:3053
msgid "Babilim finds the plugins and themes on this site that have no translation for your language and installs one for each."
msgstr "Babilim atopa os plugins e temas deste sitio que non teñen tradución para o seu idioma e instala unha para cada un."

