msgstr "Babilim tute sydło aktiwizuje a přepruwuje… (poslední spyt: %s)"

#: admin/class-babilim-admin.php:2376
msgid "Babilim is enabling and checking this site… Reload this page or wait for the scheduled check to finish."
msgstr "Babilim tute sydło aktiwizuje a přepruwuje… Začitajće stronu znowa abo čakajće na kónc planowaneho přepruwowanja."

#: admin/class-babilim-admin.php:4426
