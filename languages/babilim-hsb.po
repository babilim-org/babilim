msgstr[2] "Babilim je zapnjeny: sydło je wobkrućene a %d komponenty bu namakane."
msgstr[3] "Babilim je zapnjeny: sydło je wobkrućene a %d komponentow bu namakanych."

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:3148
#, php-format
