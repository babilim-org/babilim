msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Zapjelni falowace přełožki za rozšěrjenja a drasty, kotrež su so hižo na twojim sydle instalowali."

#: admin/class-babilim-admin.php:1274
msgid "That upload screen was out of date: a different upload has been prepared since. Nothing was sent. Review the current one from the Translations list."
msgstr "Ta wobrazowka za nahraće bě zestarjena: pozdźišo je so druhe nahraće přihotowało. Ničo njebu pósłane. Přepruwuj aktualne nahraće z Lisćiny přełožkow."

#: admin/class-babilim-admin.php:3067
msgid "The free service plan gives each site a limited number of slots for plugins and themes; the slots in use are shown in Settings after you enable Babilim."
msgstr "Darmotny słužbowy plan dawa kóždemu sydłu wobmjezowany ličbu městnow za rozšěrjenja a drasty; wužiwane městna so w nastajenjach pokazuja, po tym zo sy Babilim zmóžnił."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:62
#, php-format
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site (the limit is %1$d for themes and %2$d for plugins), unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Wužadanje přełožka stají tute rozšěrjenje abo tutu drastu na jedne z městnow darmotneho słužboweho plana za to sydło (limit je %1$d za drasty a %2$d za rozšěrjenja), chibazo ma hižo jedne. Městno wostanje wužiwane a njeporadźeny přełožk jo njewuswobodźi."

#: admin/class-babilim-translations-table.php:67
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site, unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Wužadanje přełožka stají tute rozšěrjenje abo tutu drastu na jedne z městnow darmotneho słužboweho plana za to sydło, chibazo ma hižo jedne. Městno wostanje wužiwane a njeporadźeny přełožk jo njewuswobodźi."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:80
#, php-format
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one (the limit is %1$d for themes and %2$d for plugins). A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Jeli tute rozšěrjenje abo tuta drasta hišće njeje na jednym z městnow darmotneho słužboweho plana za to sydło, stají wužadanje přełožka jo na jedne (limit je %1$d za drasty a %2$d za rozšěrjenja). Městno wostanje wužiwane a njeporadźeny přełožk jo njewuswobodźi. Pokročować?"

#: admin/class-babilim-translations-table.php:85
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one. A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Jeli tute rozšěrjenje abo tuta drasta hišće njeje na jednym z městnow darmotneho słužboweho plana za to sydło, stají wužadanje přełožka jo na jedne. Městno wostanje wužiwane a njeporadźeny přełožk jo njewuswobodźi. Pokročować?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1974
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d sydło w tutej syći je nastajene, zo by swoju identitu Babilim zhašało, hdyž so tykač zhaša. Płaćena licenca, kotraž je z tutym sydłom zwjazana, njemóhła so potom awtomatisce wobnowić; dyrbjeli byšće so z podpěru Babilim na %2$s do zwiska stajić. Zo byšće identitu wobchowali, klikńće na Přetorhnyć, wotkliknće hódnotu „Při wotinstalowanju wšě daty Babilim zhašeć“ w nastajenjach Babilim tutoho sydła a deaktiwujće hišće raz. Tola deaktiwować?"
msgstr[1] "%1$d sydle w tutej syći stej nastajenej, zo bystej swoju identitu Babilim zhašałoj, hdyž so tykač zhaša. Płaćena licenca, kotraž je z tymaj sydloma zwjazana, njemóhła so potom awtomatisce wobnowić; dyrbjeli byšće so z podpěru Babilim na %2$s do zwiska stajić. Zo byšće identity wobchowali, klikńće na Přetorhnyć, wotkliknće hódnotu „Při wotinstalowanju wšě daty Babilim zhašeć“ w nastajenjach Babilim kóždeho sydła a deaktiwujće hišće raz. Tola deaktiwować?"
msgstr[2] "%1$d sydła w tutej syći su nastajene, zo bychu swoju identitu Babilim zhašeli, hdyž so tykač zhaša. Płaćena licenca, kotraž je z tutymi sydłami zwjazana, njemóhła so potom awtomatisce wobnowić; dyrbjeli byšće so z podpěru Babilim na %2$s do zwiska stajić. Zo byšće identity wobchowali, klikńće na Přetorhnyć, wotkliknće hódnotu „Při wotinstalowanju wšě daty Babilim zhašeć“ w nastajenjach Babilim kóždeho sydła a deaktiwujće hišće raz. Tola deaktiwować?"
msgstr[3] "%1$d sydłow w tutej syći je nastajenych, zo bychu swoju identitu Babilim zhašeli, hdyž so tykač zhaša. Płaćena licenca, kotraž je z tutymi sydłami zwjazana, njemóhła so potom awtomatisce wobnowić; dyrbjeli byšće so z podpěru Babilim na %2$s do zwiska stajić. Zo byšće identity wobchowali, klikńće na Přetorhnyć, wotkliknće hódnotu „Při wotinstalowanju wšě daty Babilim zhašeć“ w nastajenjach Babilim kóždeho sydła a deaktiwujće hišće raz. Tola deaktiwować?"

