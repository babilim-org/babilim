msgstr "Babilim hat gjin oersetting foar dizze taal ynstallearre."

#: admin/class-babilim-admin.php:2517
msgid "Babilim hit an error. Share an error report?"
msgstr "Babilim hat in flater tsjinkommen. In flaterrapport diele?"

