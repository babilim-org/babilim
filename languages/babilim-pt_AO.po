msgstr "O Babilim não conseguiu concluir a ativação (%1$s): %2$s"

#: admin/class-babilim-admin.php:3792
msgid "Babilim could not finish verifying this site (the service could not reach it back). Registration is paused."
msgstr "O Babilim não conseguiu concluir a verificação deste site (o serviço não conseguiu contactá-lo de volta). O registo está em pausa."

#: includes/class-babilim-site.php:434
