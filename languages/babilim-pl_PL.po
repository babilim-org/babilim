#: admin/class-babilim-admin.php:2386
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "Hosting obsługujący tylko jedno żądanie PHP naraz nie może ukończyć tego kroku."

#: includes/class-babilim-upload.php:293
msgid "A part of the upload kept failing, so the upload was cancelled."
msgstr "Jedna część przesyłania wciąż kończyła się niepowodzeniem, więc przesyłanie zostało anulowane."

#: admin/class-babilim-admin.php:1377
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "Tłumaczenie dla tego locale nie może być teraz zażądane w tej witrynie."

#. translators: 1: when the conflicting write happened, 2: which part of the index it was for.
#: admin/class-babilim-admin.php:4862
#, php-format
