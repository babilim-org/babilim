msgstr "manifest.json-এ 'files' অনুপস্থিত বা অবৈধ।"

#: includes/class-babilim-installer.php:480
msgid "manifest.json is missing or has an invalid 'extra_domains'."
msgstr "manifest.json-এ 'extra_domains' অনুপস্থিত বা অবৈধ।"

#: includes/class-babilim-installer.php:483
msgid "manifest.json is missing or has an invalid 'build_no'."
msgstr "manifest.json-এ 'build_no' অনুপস্থিত বা অবৈধ।"

