msgid "manifest.json is missing or has an invalid 'entries'."
msgstr "manifest.json-ত 'entries' নাই বা ইয়াৰ মান অবৈধ।"

#: includes/class-babilim-installer.php:477
msgid "manifest.json is missing or has an invalid 'files'."
msgstr "manifest.json-ত 'files' নাই বা ইয়াৰ মান অবৈধ।"

#: includes/class-babilim-installer.php:480
msgid "manifest.json is missing or has an invalid 'extra_domains'."
msgstr "manifest.json-ত 'extra_domains' নাই বা ইয়াৰ মান অবৈধ।"

#: includes/class-babilim-installer.php:483
msgid "manifest.json is missing or has an invalid 'build_no'."
msgstr "manifest.json-ত 'build_no' নাই বা ইয়াৰ মান অবৈধ।"

#: includes/class-babilim-installer.php:486
msgid "manifest.json's 'server_build_id' is not a valid build id."
msgstr "manifest.json ৰ 'server_build_id' এটা বৈধ বিল্ড আইডি নহয়।"

#: includes/class-babilim-installer.php:489
