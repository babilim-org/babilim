msgstr "სერვისმა სთხოვა ამ საიტს, სანამ ხელახლა სინქრონიზებას დაიწყებს, დაელოდოს."

#. translators: 1: number of components, 2: number of languages, 3: number of check batches needed, 4: the most batches one run can send.
#: includes/class-babilim-site.php:911
#, php-format
msgid "This site has %1$d components across %2$d languages, which needs %3$d check batches; Babilim can handle at most %4$d per run. Reduce the managed languages in Settings or deactivate unused plugins and themes, then press Check again now."
msgstr "ამ საიტს აქვს %1$d კომპონენტი %2$d ენაზე, რაც საჭიროებს %3$d შემოწმების ჯგუფს; Babilim-ს ერთ გაშვებაში მაქსიმუმ %4$d ჯგუფის დამუშავება შეუძლია. შეამცირეთ მართული ენები პარამეტრები-ში ან გამორთეთ გამოუყენებელი დანამატები და თემები, შემდეგ დააჭირეთ ღილაკს „ხელახლა შემოწმება ახლავე“."

#: includes/class-babilim-site.php:986
msgid "Babilim could not finish checking this site."
msgstr "Babilim-მა ვერ დაასრულა ამ საიტის შემოწმება."

#: includes/class-babilim-site.php:1481
msgid "This site's address is too long for Babilim to register."
msgstr "ამ საიტის მისამართი ძალიან გრძელია Babilim-ში დასარეგისტრირებლად."

#: includes/class-babilim-site.php:1484
msgid "This site's locale code is not one Babilim can register."
msgstr "ამ საიტის ლოკალის კოდის რეგისტრაცია Babilim-ში შეუძლებელია."

#: includes/class-babilim-sync-installer.php:330
msgid "The download response was missing a usable location."
msgstr "ჩამოტვირთვის პასუხს არ ჰქონდა გამოსადეგი მდებარეობა."

#: includes/class-babilim-upload.php:64
#: includes/class-babilim-upload.php:69
msgid "The service's upload offer was incomplete."
msgstr "სერვისის ატვირთვის შეთავაზება არასრული იყო."

#: includes/class-babilim-upload.php:109
msgid "This component is larger than the service accepts, so it cannot be uploaded."
msgstr "ეს კომპონენტი სერვისის დასაშვებ ზომას აღემატება, ამიტომ მისი ატვირთვა შეუძლებელია."

#: includes/class-babilim-upload.php:153
msgid "The packaged component could not be read."
msgstr "დაპაკეტებული კომპონენტის წაკითხვა ვერ მოხერხდა."

#: includes/class-babilim-upload.php:264
msgid "A part of the upload kept failing, so the upload was cancelled."
msgstr "ატვირთვის ერთი ნაწილი განმეორებით ჩაიშალა, ამიტომ ატვირთვა გაუქმდა."

#. translators: %s: the file path that could not be read.
#: includes/class-babilim-wp-fs.php:91
#, php-format
msgid "Could not read: %s"
msgstr "წაკითხვა ვერ მოხერხდა: %s"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1719
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
