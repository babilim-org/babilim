msgstr "%1$s-ot translation index-or (%2$s) lekha ekkhan onno request-or logé takkor khaiyé, tai lagano oy nai; sob'cheye notun version rakha oiyé."

#. translators: 1: when the write failed, 2: which part of the index it was for, 3: a short technical reason code.
#: admin/class-babilim-admin.php:4875
#, php-format
msgid "A translation-index write on %1$s (%2$s) could not be completed and was not applied (%3$s)."
msgstr "%1$s-ót translation index (%2$s) lekha shesh gora zay ni, tai lagano oyni (%3$s)."

