msgstr "Ekbar-ot khali ekkhan PHP request chalaiya host ei step sesh goirte nafare."

#: includes/class-babilim-upload.php:293
msgid "A part of the upload kept failing, so the upload was cancelled."
msgstr "Upload ror ekkon ongso bar bar fail oiyé, ei lagi upload bondo goira dewa oilo."

#: admin/class-babilim-admin.php:1377
