msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "توهان جي سائيٽ تي اڳ ۾ ئي انسٽال ٿيل پلگ ان ۽ ٿيمز لاءِ غائب ترجما پورا ڪري ٿو."

#: admin/class-babilim-admin.php:354
#: admin/class-babilim-admin.php:355
#: admin/class-babilim-translations-table.php:400
msgid "Translations"
msgstr "ترجما"

#: admin/class-babilim-admin.php:362
msgid "Babilim Settings"
msgstr "Babilim سيٽنگون"

#: admin/class-babilim-admin.php:363
#: admin/class-babilim-admin.php:2671
#: admin/class-babilim-admin.php:2960
msgid "Settings"
msgstr "سيٽنگون"

#: admin/class-babilim-admin.php:390
#: admin/class-babilim-admin.php:789
msgid "You are not allowed to do this."
msgstr "توهان کي هي ڪم ڪرڻ جي اجازت ناهي."

#. translators: 1: the most operations one run accepts, 2: how many were selected.
#: admin/class-babilim-admin.php:419
#, php-format
msgid "Select fewer components: at most %1$d operations per run (you selected %2$d)."
msgstr "گھٽ جزا چونڊيو: هر رن ۾ وڌ ۾ وڌ %1$d آپريشن (توهان %2$d چونڊيا آهن)."

#: admin/class-babilim-admin.php:432
#: admin/class-babilim-admin.php:1110
#: admin/class-babilim-admin.php:1281
msgid "That component is not installed on this site, so a translation cannot be requested for it."
msgstr "اهو جزو هن سائيٽ تي انسٽال ٿيل ناهي، تنھنڪري ان لاءِ ترجمي جي درخواست نٿي ڪري سگھجي."

#: admin/class-babilim-admin.php:911
msgid "Already installed."
msgstr "اڳ ۾ ئي انسٽال ٿيل آهي."

#: admin/class-babilim-admin.php:911
msgid "Downloaded and installed."
msgstr "ڊائونلوڊ ۽ انسٽال ٿي ويو."

#: admin/class-babilim-admin.php:934
#: admin/class-babilim-admin.php:1275
#: admin/class-babilim-admin.php:1353
#: admin/class-babilim-admin.php:1954
#: admin/class-babilim-admin.php:2229
#: includes/class-babilim-api-client.php:532
#: includes/class-babilim-site.php:311
#: includes/class-babilim-site.php:362
#: includes/class-babilim-site.php:705
#: includes/class-babilim-site.php:838
msgid "Babilim has not been enabled for this site yet."
msgstr "Babilim کي هن سائيٽ لاءِ اڃا فعال نه ڪيو ويو آهي."

#: admin/class-babilim-admin.php:953
msgid "No build is available to download for this locale."
msgstr "هن لوڪيل لاءِ ڊائونلوڊ ڪرڻ جي ڪا بلڊ موجود ناهي."

#: admin/class-babilim-admin.php:1008
msgid "Rolled back to the previous build."
msgstr "اڳئين بلڊ ڏانهن واپس موٽايو ويو."

#: admin/class-babilim-admin.php:1067
msgid "Rolled back and reported."
msgstr "واپس ورتو ويو ۽ رپورٽ ڪئي وئي."

#. translators: %s: why sending the report failed.
#: admin/class-babilim-admin.php:1073
#, php-format
msgid "Rolled back, but the report could not be sent: %s"
msgstr "اڳيون بلڊ بحال ڪيو ويو، پر رپورٽ موڪلي نه سگھجي: %s"

#: admin/class-babilim-admin.php:1097
msgid "Removed."
msgstr "هٽايو ويو."

#: admin/class-babilim-admin.php:1133
msgid "Translation requested."
msgstr "ترجمي جي درخواست ڪئي وئي."

#: admin/class-babilim-admin.php:1155
msgid "This component was already uploaded. Babilim is checking it now."
msgstr "هي جزو اڳ ۾ ئي اپلوڊ ٿي چڪو آهي. Babilim هاڻي ان کي چڪاسي رهيو آهي."

#: admin/class-babilim-admin.php:1195
msgid "Upload cancelled."
msgstr "اپلوڊ رد ڪيو ويو."

#: admin/class-babilim-admin.php:1206
msgid "Upload complete — translation requested."
msgstr "اپلوڊ مڪمل — ترجمي جي درخواست ڪئي وئي."

#: admin/class-babilim-admin.php:1284
msgid "This component does not declare a version number, so a translation cannot be requested for it."
msgstr "هي جزو ورزن نمبر ظاهر نٿو ڪري، تنھنڪري ان لاءِ ترجمي جي درخواست نٿي ڪري سگھجي."

#. translators: %d: the most characters a version number may have.
#: admin/class-babilim-admin.php:1291
#, php-format
msgid "This component's version number is longer than %d characters, which Babilim cannot handle, so a translation cannot be requested for it."
msgstr "هن جزو جو ورزن نمبر %d اکرن کان ڊگھو آهي، جنهن کي Babilim سنڀالي نٿو سگھي، تنھنڪري ان لاءِ ترجمي جي درخواست نٿي ڪري سگھجي."

#: admin/class-babilim-admin.php:1297
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "هن وقت هن سائيٽ تي ان لوڪيل لاءِ ترجمي جي درخواست نٿي ڪري سگھجي."

#: admin/class-babilim-admin.php:1323
#: admin/class-babilim-admin.php:3688
msgid "Thank you. Your report was sent."
msgstr "مهرباني. توهان جي رپورٽ موڪلي وئي."

#: admin/class-babilim-admin.php:1358
msgid "This report does not name a valid plugin or theme and locale."
msgstr "هي رپورٽ ڪنهن صحيح پلگ ان يا ٿيم ۽ لوڪيل جو نالو نٿي ٻڌائي."

#: admin/class-babilim-admin.php:1365
msgid "Please choose a category for this report."
msgstr "مهرباني ڪري هن رپورٽ لاءِ زمرو چونڊيو."

#: admin/class-babilim-admin.php:1369
msgid "This report is missing a valid build to report against."
msgstr "هن رپورٽ وٽ رپورٽ ڪرڻ لاءِ صحيح بلڊ ناهي."

#: admin/class-babilim-admin.php:1372
msgid "This build is not one this site currently knows about for this component/locale."
msgstr "هي بلڊ اهڙو ناهي جنهن کي هيءَ سائيٽ هن جزو/لوڪيل لاءِ هن وقت ڄاڻي ٿي."

#. translators: 1: the name of a form field, 2: how many characters it has, 3: the most characters it may have.
#: admin/class-babilim-admin.php:1442
#, php-format
msgid "The field \"%1$s\" is too long: it has %2$d characters and the limit is %3$d. Nothing was sent; please shorten it and try again."
msgstr "فيلڊ \"%1$s\" تمام ڊگھو آهي: ان ۾ %2$d اکر آهن ۽ حد %3$d آهي. ڪجھ به موڪليو نه ويو؛ مهرباني ڪري ان کي ننڍو ڪري ٻيهر ڪوشش ڪريو."

#: admin/class-babilim-admin.php:3666
msgid "Original string"
msgstr "اصل اسٽرنگ"

#: admin/class-babilim-admin.php:3681
msgid "String context"
msgstr "اسٽرنگ جو سياق"

#: admin/class-babilim-admin.php:1467
#: admin/class-babilim-admin.php:3667
#: admin/class-babilim-admin.php:4406
msgid "Current translation"
msgstr "موجوده ترجمو"

#: admin/class-babilim-admin.php:1471
#: admin/class-babilim-admin.php:3671
#: admin/class-babilim-admin.php:4408
msgid "Suggested translation"
msgstr "تجويز ڪيل ترجمو"

#: admin/class-babilim-admin.php:1475
#: admin/class-babilim-admin.php:3672
#: admin/class-babilim-admin.php:4410
msgid "Note (optional)"
msgstr "نوٽ (اختياري)"

#: admin/class-babilim-admin.php:1479
#: admin/class-babilim-admin.php:4412
msgid "Where you saw this (optional)"
msgstr "توهان هي ڪٿي ڏٺو (اختياري)"

#. translators: %s: the date and time syncing is expected to resume.
#: admin/class-babilim-admin.php:1542
#, php-format
msgid "Babilim sync is temporarily delayed by the service (rate limited); it will try again after %s."
msgstr "Babilim سنڪ کي سروس طرفان عارضي طور روڪيو ويو آهي (درخواستن جي تعداد جي حد ٿي وئي آهي)؛ اها %s کان پوءِ ٻيهر ڪوشش ڪندي."

#: admin/class-babilim-admin.php:1576
msgid "That is not a valid WordPress locale code. Nothing was saved."
msgstr "هي صحيح WordPress لوڪيل ڪوڊ ناهي. ڪجهه به محفوظ نه ڪيو ويو."

#: admin/class-babilim-admin.php:1619
msgid "Settings saved."
msgstr "سيٽنگون محفوظ ٿي ويون."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1681
#, php-format
msgid "If this is on, uninstalling also erases this site's identity. The paid license attached to this site cannot be restored automatically afterwards; you would have to contact Babilim support at %s to get it back."
msgstr "جيڪڏهن هيءَ آن آهي، ته ان انسٽال ڪرڻ سان هن سائيٽ جي سڃاڻپ به ختم ٿي ويندي. هن سائيٽ سان جڙيل ادا ڪيل لائسنس بعد ۾ پاڻمرادو بحال نه ٿي سگهندو؛ ان کي واپس وٺڻ لاءِ توهان کي %s تي Babilim سپورٽ سان رابطو ڪرڻو پوندو."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1697
#, php-format
msgid "Babilim is set to erase this site's identity when the plugin is deleted. The paid license attached to this site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in the Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Babilim کي ترتيب ڏنو ويو آهي ته پلگ ان ڊاهڻ وقت هن سائيٽ جي سڃاڻپ ختم ڪري. پوءِ هن سائيٽ سان جڙيل ادا ڪيل لائسنس پاڻمرادو بحال نه ٿي سگهندو؛ توهان کي %s تي Babilim سپورٽ سان رابطو ڪرڻو پوندو. سڃاڻپ رکڻ لاءِ Cancel دٻايو، Babilim سيٽنگون ۾ \"ان انسٽال ڪرڻ وقت Babilim جو سمورو ڊيٽا ڊاهي ڇڏيو\" جو نشان هٽايو، ۽ وري غير فعال ڪريو. ته به غير فعال ڪريون؟"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1722
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "هن نيٽ ورڪ تي %1$d سائيٽ کي ترتيب ڏنو ويو آهي ته پلگ ان ڊاهڻ وقت پنهنجي Babilim سڃاڻپ ختم ڪري. ان سائيٽ سان جڙيل ادا ڪيل لائسنس پوءِ پاڻمرادو بحال نه ٿي سگهندو؛ توهان کي %2$s تي Babilim سپورٽ سان رابطو ڪرڻو پوندو. سڃاڻپ رکڻ لاءِ Cancel دٻايو، ان سائيٽ جي Babilim سيٽنگون ۾ \"ان انسٽال ڪرڻ وقت Babilim جو سمورو ڊيٽا ڊاهي ڇڏيو\" جو نشان هٽايو، ۽ وري غير فعال ڪريو. ته به غير فعال ڪريون؟"
msgstr[1] "هن نيٽ ورڪ تي %1$d سائيٽون ترتيب ڏنيون ويون آهن ته پلگ ان ڊاهڻ وقت پنهنجي Babilim سڃاڻپ ختم ڪن. انهن سائيٽن سان جڙيل ادا ڪيل لائسنس پوءِ پاڻمرادو بحال نه ٿي سگهندا؛ توهان کي %2$s تي Babilim سپورٽ سان رابطو ڪرڻو پوندو. سڃاڻپون رکڻ لاءِ Cancel دٻايو، هر سائيٽ جي Babilim سيٽنگون ۾ \"ان انسٽال ڪرڻ وقت Babilim جو سمورو ڊيٽا ڊاهي ڇڏيو\" جو نشان هٽايو، ۽ وري غير فعال ڪريو. ته به غير فعال ڪريون؟"

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1741
#, php-format
msgid "This network has too many sites to check them one by one, and some of them may be set to erase their Babilim identity when the plugin is deleted. The paid license attached to such a site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "هن نيٽ ورڪ ۾ ايتريون سائيٽون آهن جو انهن کي هڪ هڪ ڪري چيڪ ڪري نٿو سگهجي، ۽ ڪجهه سائيٽون شايد پلگ ان ڊاهڻ وقت پنهنجي Babilim سڃاڻپ ختم ڪرڻ لاءِ ترتيب ڏنل هجن. اهڙي سائيٽ سان جڙيل ادا ڪيل لائسنس پوءِ پاڻمرادو بحال نه ٿي سگهندو؛ توهان کي %s تي Babilim سپورٽ سان رابطو ڪرڻو پوندو. سڃاڻپون رکڻ لاءِ Cancel دٻايو، هر سائيٽ جي Babilim سيٽنگون ۾ \"ان انسٽال ڪرڻ وقت Babilim جو سمورو ڊيٽا ڊاهي ڇڏيو\" جو نشان هٽايو، ۽ وري غير فعال ڪريو. ته به غير فعال ڪريون؟"

#: admin/class-babilim-admin.php:1830
msgid "Open Babilim settings"
msgstr "Babilim سيٽنگون کوليو"

#: admin/class-babilim-admin.php:1835
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Babilim هن سائيٽ جي تصديق نه ڪري سگھيو، تنهنڪري ڪجھ به ڊائونلوڊ يا انسٽال نه ڪيو ويو آهي."

#: admin/class-babilim-admin.php:1847
msgid "The service could not reach your site. A firewall, security plugin or host rule is probably blocking the request; please allow requests to /wp-json/babilim/v1/challenge."
msgstr "سروس توهان جي سائيٽ تائين پهچي نه سگھي. ممڪن آهي ته ڪو فائر وال، سيڪيورٽي پلگ ان يا هوسٽ جو ضابطو درخواست کي بلاڪ ڪري رهيو آهي؛ مهرباني ڪري /wp-json/babilim/v1/challenge ڏانهن درخواستن جي اجازت ڏيو."

#: admin/class-babilim-admin.php:1849
msgid "Your site took too long to answer. Please try again later, and check that your host is not too slow or overloaded."
msgstr "توهان جي سائيٽ جواب ڏيڻ ۾ ڏاڍو وقت ورتو. مهرباني ڪري بعد ۾ ٻيهر ڪوشش ڪريو، ۽ چيڪ ڪريو ته توهان جو هوسٽ تمام سست يا اوور لوڊ ته ناهي."

#: admin/class-babilim-admin.php:1851
msgid "Your site answered, but not with what was expected. The REST API may be rewritten by another plugin, or that endpoint may be cached; please exclude /wp-json/babilim/v1/challenge from caching and rewriting."
msgstr "توهان جي سائيٽ جواب ڏنو، پر اهو نه جيڪو متوقع هو. ٿي سگھي ٿو ڪو ٻيو پلگ ان REST API کي ٻيهر لکي رهيو هجي، يا اهو اينڊ پوائنٽ ڪيش ٿيل هجي؛ مهرباني ڪري /wp-json/babilim/v1/challenge کي ڪيشنگ ۽ ريرائيٽنگ کان ٻاهر رکو."

#: admin/class-babilim-admin.php:1853
msgid "Please check that your site can be reached from the internet, then try again."
msgstr "مهرباني ڪري چيڪ ڪريو ته توهان جي سائيٽ انٽرنيٽ تان پهچي سگھجي ٿي، پوءِ ٻيهر ڪوشش ڪريو."

#: admin/class-babilim-admin.php:1876
msgid "Re-verify"
msgstr "ٻيهر تصديق ڪريو"

#. translators: 1: number of components left out, 2: number of locales left out.
#: admin/class-babilim-admin.php:1897
#, php-format
msgid "This site is over the size the service accepts in one sync, so some items were left out: %1$d components and %2$d locales."
msgstr "هيءَ سائيٽ ان سائيز کان وڌيڪ آهي جيڪا سروس هڪ ئي سنڪ ۾ قبول ڪري ٿي، تنهنڪري ڪجھ شيون ڇڏيون ويون: %1$d جزا ۽ %2$d لوڪيل."

#: admin/class-babilim-admin.php:1926
msgid "This site is verified."
msgstr "هن سائيٽ جي تصديق ٿي چڪي آهي."

#: admin/class-babilim-admin.php:1939
msgid "Registration restarted."
msgstr "رجسٽريشن ٻيهر شروع ٿي وئي."

#: admin/class-babilim-admin.php:1960
#: admin/class-babilim-admin.php:2034
msgid "Sync complete."
msgstr "هم وقت سازي مڪمل."

#: admin/class-babilim-admin.php:1995
msgid "Babilim is enabling and checking this site… Reload this page or wait for the scheduled check to finish."
msgstr "Babilim هن سائيٽ کي فعال ۽ چيڪ ڪري رهيو آهي… هي صفحو ٻيهر لوڊ ڪريو يا شيڊول ٿيل چيڪ مڪمل ٿيڻ جو انتظار ڪريو."

#. translators: 1: short name of the step that failed, 2: the message for that failure.
#: admin/class-babilim-admin.php:2000
#, php-format
msgid "Babilim could not finish enabling (%1$s): %2$s"
msgstr "Babilim فعال ڪرڻ مڪمل نه ڪري سگھيو (%1$s): %2$s"

#: admin/class-babilim-admin.php:2005
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "اهڙو هوسٽ جيڪو هڪ وقت ۾ صرف هڪ PHP درخواست سنڀالي ٿو، هي قدم مڪمل نٿو ڪري سگھي."

#. translators: %d: number of components found on this site.
#: admin/class-babilim-admin.php:2026
#, php-format
msgid "Babilim is enabled: this site is verified and %d component was found."
msgid_plural "Babilim is enabled: this site is verified and %d components were found."
msgstr[0] "Babilim فعال آهي: هن سائيٽ جي تصديق ٿي چڪي آهي ۽ %d جزو مليو."
msgstr[1] "Babilim فعال آهي: هن سائيٽ جي تصديق ٿي چڪي آهي ۽ %d جزا مليا."

#: admin/class-babilim-admin.php:2111
msgid "Babilim is disabled. Nothing more is sent; translations already installed keep working."
msgstr "Babilim غير فعال آهي. وڌيڪ ڪجهه به نه موڪليو ويندو؛ اڳ ۾ انسٽال ٿيل ترجما ڪم ڪندا رهندا."

#: admin/class-babilim-admin.php:2243
msgid "Supplementary translation index rebuilt."
msgstr "اضافي ترجمي جو انڊيڪس ٻيهر ٺاهيو ويو."

#. translators: %d: number of files deleted by this sweep.
#: admin/class-babilim-admin.php:2261
#, php-format
msgid "Sweep complete: %d file deleted."
msgid_plural "Sweep complete: %d files deleted."
msgstr[0] "صفايو مڪمل: %d فائيل ڊاهيو ويو."
