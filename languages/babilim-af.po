#. translators: %s: link to the Settings page, with the text "Settings".
#: admin/class-babilim-admin.php:2845
#, php-format
msgid "These are the languages this site uses. You can change them in %s."
msgstr "Dit is die tale wat hierdie webwerf gebruik. Jy kan dit in %s verander."

#: admin/class-babilim-admin.php:2864
