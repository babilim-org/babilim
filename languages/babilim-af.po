msgstr "Babilim is nog nie vir hierdie webwerf geaktiveer nie."

#: admin/class-babilim-admin.php:953
msgid "No build is available to download for this locale."
msgstr "Geen weergawe is beskikbaar om vir hierdie locale af te laai nie."

#: admin/class-babilim-admin.php:1008
msgid "Rolled back to the previous build."
msgstr "Teruggerol na die vorige weergawe."

#: admin/class-babilim-admin.php:1067
msgid "Rolled back and reported."
msgstr "Teruggerol en gerapporteer."

#. translators: %s: why sending the report failed.
#: admin/class-babilim-admin.php:1073
#, php-format
msgid "Rolled back, but the report could not be sent: %s"
msgstr "Teruggerol, maar die verslag kon nie gestuur word nie: %s"

#: admin/class-babilim-admin.php:1097
msgid "Removed."
msgstr "Verwyder."

#: admin/class-babilim-admin.php:1133
msgid "Translation requested."
msgstr "Vertaling aangevra."

#: admin/class-babilim-admin.php:1155
msgid "This component was already uploaded. Babilim is checking it now."
msgstr "Hierdie komponent is reeds opgelaai. Babilim gaan dit nou na."

#: admin/class-babilim-admin.php:1195
msgid "Upload cancelled."
msgstr "Oplaai gekanselleer."

#: admin/class-babilim-admin.php:1206
msgid "Upload complete — translation requested."
msgstr "Oplaai voltooi — vertaling aangevra."

#: admin/class-babilim-admin.php:1284
msgid "This component does not declare a version number, so a translation cannot be requested for it."
msgstr "Hierdie komponent verklaar nie 'n weergawenommer nie, so 'n vertaling kan nie daarvoor aangevra word nie."

#. translators: %d: the most characters a version number may have.
#: admin/class-babilim-admin.php:1291
#, php-format
msgid "This component's version number is longer than %d characters, which Babilim cannot handle, so a translation cannot be requested for it."
msgstr "Hierdie komponent se weergawenommer is langer as %d karakters, wat Babilim nie kan hanteer nie, so 'n vertaling kan nie daarvoor aangevra word nie."

#: admin/class-babilim-admin.php:1297
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "'n Vertaling kan tans nie vir daardie locale op hierdie webwerf aangevra word nie."

#: admin/class-babilim-admin.php:1323
#: admin/class-babilim-admin.php:3688
msgid "Thank you. Your report was sent."
msgstr "Dankie. Jou verslag is gestuur."

#: admin/class-babilim-admin.php:1358
msgid "This report does not name a valid plugin or theme and locale."
msgstr "Hierdie verslag gee nie die naam van 'n geldige inprop of tema en locale nie."

#: admin/class-babilim-admin.php:1365
msgid "Please choose a category for this report."
msgstr "Kies asseblief 'n kategorie vir hierdie verslag."

#: admin/class-babilim-admin.php:1369
msgid "This report is missing a valid build to report against."
msgstr "Hierdie verslag het nie 'n geldige weergawe waarop dit betrekking het nie."

#: admin/class-babilim-admin.php:1372
msgid "This build is not one this site currently knows about for this component/locale."
msgstr "Hierdie weergawe is nie een wat hierdie webwerf tans ken vir hierdie komponent/locale nie."

#. translators: 1: the name of a form field, 2: how many characters it has, 3: the most characters it may have.
#: admin/class-babilim-admin.php:1442
#, php-format
msgid "The field \"%1$s\" is too long: it has %2$d characters and the limit is %3$d. Nothing was sent; please shorten it and try again."
msgstr "Die veld \"%1$s\" is te lank: dit het %2$d karakters en die limiet is %3$d. Niks is gestuur nie; verkort dit asseblief en probeer weer."

#: admin/class-babilim-admin.php:3666
msgid "Original string"
msgstr "Oorspronklike string"

#: admin/class-babilim-admin.php:3681
msgid "String context"
msgstr "Stringkonteks"

#: admin/class-babilim-admin.php:1467
#: admin/class-babilim-admin.php:3667
#: admin/class-babilim-admin.php:4406
msgid "Current translation"
msgstr "Huidige vertaling"

#: admin/class-babilim-admin.php:1471
#: admin/class-babilim-admin.php:3671
#: admin/class-babilim-admin.php:4408
msgid "Suggested translation"
msgstr "Voorgestelde vertaling"

#: admin/class-babilim-admin.php:1475
#: admin/class-babilim-admin.php:3672
#: admin/class-babilim-admin.php:4410
msgid "Note (optional)"
msgstr "Nota (opsioneel)"

#: admin/class-babilim-admin.php:1479
#: admin/class-babilim-admin.php:4412
msgid "Where you saw this (optional)"
msgstr "Waar jy dit gesien het (opsioneel)"

#. translators: %s: the date and time syncing is expected to resume.
#: admin/class-babilim-admin.php:1542
#, php-format
msgid "Babilim sync is temporarily delayed by the service (rate limited); it will try again after %s."
msgstr "Babilim-sinkronisering is tydelik deur die diens vertraag (tempobeperk); dit sal weer probeer na %s."

#: admin/class-babilim-admin.php:1576
msgid "That is not a valid WordPress locale code. Nothing was saved."
msgstr "Dit is nie 'n geldige WordPress-locale-kode nie. Niks is gestoor nie."

#: admin/class-babilim-admin.php:1619
msgid "Settings saved."
msgstr "Instellings gestoor."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1681
#, php-format
msgid "If this is on, uninstalling also erases this site's identity. The paid license attached to this site cannot be restored automatically afterwards; you would have to contact Babilim support at %s to get it back."
msgstr "As dit aan is, vee deïnstallering ook hierdie webwerf se identiteit uit. Die betaalde lisensie wat aan hierdie webwerf gekoppel is, kan daarna nie outomaties herstel word nie; jy sal Babilim-ondersteuning by %s moet kontak om dit terug te kry."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1697
#, php-format
msgid "Babilim is set to erase this site's identity when the plugin is deleted. The paid license attached to this site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in the Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Babilim is ingestel om hierdie webwerf se identiteit uit te vee wanneer die inprop uitgevee word. Die betaalde lisensie wat aan hierdie webwerf gekoppel is, kan dan nie outomaties herstel word nie; jy sal Babilim-ondersteuning by %s moet kontak. Om die identiteit te behou, druk Kanselleer, ontmerk \"Vee alle Babilim-data uit by deïnstallering\" in die Babilim-instellings, en deaktiveer weer. Deaktiveer in elk geval?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1722
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d webwerf op hierdie netwerk is ingestel om sy Babilim-identiteit uit te vee wanneer die inprop uitgevee word. Die betaalde lisensie wat aan daardie webwerf gekoppel is, kan dan nie outomaties herstel word nie; jy sal Babilim-ondersteuning by %2$s moet kontak. Om die identiteit te behou, druk Kanselleer, ontmerk \"Vee alle Babilim-data uit by deïnstallering\" in daardie webwerf se Babilim-instellings, en deaktiveer weer. Deaktiveer in elk geval?"
msgstr[1] "%1$d webwerwe op hierdie netwerk is ingestel om hul Babilim-identiteit uit te vee wanneer die inprop uitgevee word. Die betaalde lisensie wat aan daardie webwerwe gekoppel is, kan dan nie outomaties herstel word nie; jy sal Babilim-ondersteuning by %2$s moet kontak. Om die identiteite te behou, druk Kanselleer, ontmerk \"Vee alle Babilim-data uit by deïnstallering\" in elke webwerf se Babilim-instellings, en deaktiveer weer. Deaktiveer in elk geval?"

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1741
#, php-format
msgid "This network has too many sites to check them one by one, and some of them may be set to erase their Babilim identity when the plugin is deleted. The paid license attached to such a site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Hierdie netwerk het te veel webwerwe om een vir een na te gaan, en sommige daarvan is dalk ingestel om hul Babilim-identiteit uit te vee wanneer die inprop uitgevee word. Die betaalde lisensie wat aan so 'n webwerf gekoppel is, kan dan nie outomaties herstel word nie; jy sal Babilim-ondersteuning by %s moet kontak. Om die identiteite te behou, druk Kanselleer, ontmerk \"Vee alle Babilim-data uit by deïnstallering\" in elke webwerf se Babilim-instellings, en deaktiveer weer. Deaktiveer in elk geval?"

#: admin/class-babilim-admin.php:1830
msgid "Open Babilim settings"
msgstr "Maak Babilim-instellings oop"

#: admin/class-babilim-admin.php:1835
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Babilim kon nie hierdie werf verifieer nie, so niks word afgelaai of geïnstalleer nie."

#: admin/class-babilim-admin.php:1847
msgid "The service could not reach your site. A firewall, security plugin or host rule is probably blocking the request; please allow requests to /wp-json/babilim/v1/challenge."
msgstr "Die diens kon nie jou werf bereik nie. 'n Firewall, sekuriteitsinprop of gasheerreël blokkeer waarskynlik die versoek; laat asseblief versoeke na /wp-json/babilim/v1/challenge toe."

#: admin/class-babilim-admin.php:1849
msgid "Your site took too long to answer. Please try again later, and check that your host is not too slow or overloaded."
msgstr "Jou werf het te lank geneem om te antwoord. Probeer asseblief later weer, en maak seker jou gasheer is nie te ststadig of oorlaai nie."

#: admin/class-babilim-admin.php:1851
msgid "Your site answered, but not with what was expected. The REST API may be rewritten by another plugin, or that endpoint may be cached; please exclude /wp-json/babilim/v1/challenge from caching and rewriting."
msgstr "Jou werf het geantwoord, maar nie met wat verwag is nie. Die REST API word dalk deur 'n ander inprop herskryf, of daardie eindpunt word dalk gekas; sluit asseblief /wp-json/babilim/v1/challenge uit van kas en herskrywing."

#: admin/class-babilim-admin.php:1853
msgid "Please check that your site can be reached from the internet, then try again."
msgstr "Maak asseblief seker dat jou werf vanaf die internet bereik kan word, en probeer dan weer."

#: admin/class-babilim-admin.php:1876
msgid "Re-verify"
msgstr "Verifieer weer"

#. translators: 1: number of components left out, 2: number of locales left out.
#: admin/class-babilim-admin.php:1897
#, php-format
msgid "This site is over the size the service accepts in one sync, so some items were left out: %1$d components and %2$d locales."
msgstr "Hierdie werf is groter as wat die diens in een sinchronisasie aanvaar, so sommige items is uitgelaat: %1$d komponente en %2$d locales."

#: admin/class-babilim-admin.php:1926
msgid "This site is verified."
msgstr "Hierdie werf is geverifieer."

#: admin/class-babilim-admin.php:1939
msgid "Registration restarted."
msgstr "Registrasie is herbegin."

#: admin/class-babilim-admin.php:1960
#: admin/class-babilim-admin.php:2034
msgid "Sync complete."
msgstr "Sinkronisering voltooi."

#: admin/class-babilim-admin.php:1995
msgid "Babilim is enabling and checking this site… Reload this page or wait for the scheduled check to finish."
msgstr "Babilim aktiveer en kontroleer tans hierdie werf… Herlaai hierdie bladsy of wag totdat die geskeduleerde kontrole klaar is."

#. translators: 1: short name of the step that failed, 2: the message for that failure.
#: admin/class-babilim-admin.php:2000
#, php-format
msgid "Babilim could not finish enabling (%1$s): %2$s"
msgstr "Babilim kon nie klaar aktiveer nie (%1$s): %2$s"

#: admin/class-babilim-admin.php:2005
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "'n Gasheer wat net een PHP-versoek op 'n slag hanteer, kan hierdie stap nie voltooi nie."

#. translators: %d: number of components found on this site.
#: admin/class-babilim-admin.php:2026
#, php-format
msgid "Babilim is enabled: this site is verified and %d component was found."
msgid_plural "Babilim is enabled: this site is verified and %d components were found."
msgstr[0] "Babilim is geaktiveer: hierdie webwerf is geverifieer en %d komponent is gevind."
msgstr[1] "Babilim is geaktiveer: hierdie webwerf is geverifieer en %d komponente is gevind."

#: admin/class-babilim-admin.php:2111
msgid "Babilim is disabled. Nothing more is sent; translations already installed keep working."
msgstr "Babilim is gedeaktiveer. Niks meer word gestuur nie; vertalings wat reeds geïnstalleer is, bly werk."

#: admin/class-babilim-admin.php:2243
msgid "Supplementary translation index rebuilt."
msgstr "Aanvullende vertalingsindeks is herbou."

#. translators: %d: number of files deleted by this sweep.
#: admin/class-babilim-admin.php:2261
#, php-format
msgid "Sweep complete: %d file deleted."
msgid_plural "Sweep complete: %d files deleted."
msgstr[0] "Skoonmaak voltooi: %d lêer uitgevee."
msgstr[1] "Skoonmaak voltooi: %d lêers uitgevee."

#. translators: %d: number of components removed.
#: admin/class-babilim-admin.php:2293
#, php-format
msgid "Removed %d installed component."
msgid_plural "Removed %d installed components."
msgstr[0] "%d geïnstalleerde komponent verwyder."
msgstr[1] "%d geïnstalleerde komponente verwyder."

#: admin/class-babilim-admin.php:2295
msgid "Automatic installs are now off; turn them on again in the settings if you want them."
msgstr "Outomatiese installasies is nou af; skakel dit weer aan in die instellings as jy dit wil hê."

#: admin/class-babilim-admin.php:2616
msgid "Babilim finds the plugins and themes on this site that have no translation for your language and installs one for each."
msgstr "Babilim vind die inproppe en temas op hierdie werf wat geen vertaling vir jou taal het nie en installeer een vir elk."

#. translators: %s: a list of language names, joined the way the language joins lists.
#: admin/class-babilim-admin.php:2624
#, php-format
msgid "Languages found on this site: %s."
msgstr "Tale gevind op hierdie werf: %s."

#: admin/class-babilim-admin.php:2630
msgid "The free plan covers a limited number of plugins and themes; your exact quota is shown in Settings after you enable Babilim."
msgstr "Die gratis plan dek 'n beperkte aantal inproppe en temas; jou presiese kwota word in Instellings gewys nadat jy Babilim geaktiveer het."

#: admin/class-babilim-admin.php:2631
msgid "What is sent when you enable Babilim"
msgstr "Wat gestuur word wanneer jy Babilim aktiveer"

#: admin/class-babilim-admin.php:2635
msgid "Enabling…"
msgstr "Aktiveer tans…"

#: admin/class-babilim-admin.php:2635
msgid "Enable Babilim"
msgstr "Aktiveer Babilim"

#: admin/class-babilim-admin.php:2636
msgid "By clicking Enable, you agree to send the information listed above to Babilim."
msgstr "Deur op Aktiveer te klik, stem jy in om die inligting hierbo gelys na Babilim te stuur."

#: admin/class-babilim-admin.php:2670
#: admin/class-babilim-admin.php:2718
#: admin/class-babilim-admin.php:4313
