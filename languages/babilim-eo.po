msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Plenigas mankantajn tradukojn por la kromprogramoj kaj etosoj jam instalitaj en via retejo."

#: admin/class-babilim-admin.php:320
#: admin/class-babilim-admin.php:321
#: admin/class-babilim-translations-table.php:400
msgid "Translations"
msgstr "Tradukoj"

#: admin/class-babilim-admin.php:328
msgid "Babilim Settings"
msgstr "Babilim-agordoj"

#: admin/class-babilim-admin.php:329
#: admin/class-babilim-admin.php:2510
#: admin/class-babilim-admin.php:2734
msgid "Settings"
msgstr "Agordoj"

#: admin/class-babilim-admin.php:356
#: admin/class-babilim-admin.php:763
msgid "You are not allowed to do this."
msgstr "Vi ne rajtas fari tion."

#. translators: 1: the most operations one run accepts, 2: how many were selected.
#: admin/class-babilim-admin.php:385
#, php-format
msgid "Select fewer components: at most %1$d operations per run (you selected %2$d)."
msgstr "Elektu malpli da komponantoj: maksimume %1$d operacioj por ĉiu ruligo (vi elektis %2$d)."

#: admin/class-babilim-admin.php:398
#: admin/class-babilim-admin.php:1116
#: admin/class-babilim-admin.php:1287
msgid "That component is not installed on this site, so a translation cannot be requested for it."
msgstr "Tiu komponanto ne estas instalita en ĉi tiu retejo, do traduko ne povas esti petita por ĝi."

#: admin/class-babilim-admin.php:917
msgid "Already installed."
msgstr "Jam instalita."

#: admin/class-babilim-admin.php:917
msgid "Downloaded and installed."
msgstr "Elŝutita kaj instalita."

#: admin/class-babilim-admin.php:940
#: admin/class-babilim-admin.php:1281
#: admin/class-babilim-admin.php:1357
#: admin/class-babilim-admin.php:1922
#: admin/class-babilim-admin.php:2070
#: includes/class-babilim-api-client.php:519
#: includes/class-babilim-site.php:311
#: includes/class-babilim-site.php:362
#: includes/class-babilim-site.php:705
#: includes/class-babilim-site.php:838
msgid "Babilim has not been enabled for this site yet."
msgstr "Babilim ankoraŭ ne estas ebligita por ĉi tiu retejo."

#: admin/class-babilim-admin.php:959
msgid "No build is available to download for this locale."
msgstr "Neniu kompilaĵo estas elŝutebla por ĉi tiu lingvo."

#: admin/class-babilim-admin.php:1014
msgid "Rolled back to the previous build."
msgstr "Restarigita al la antaŭa kompilaĵo."

#: admin/class-babilim-admin.php:1073
msgid "Rolled back and reported."
msgstr "Restarigita kaj raportita."

#. translators: %s: why sending the report failed.
#: admin/class-babilim-admin.php:1079
#, php-format
msgid "Rolled back, but the report could not be sent: %s"
msgstr "Restarigita, sed la raporto ne povis esti sendita: %s"

#: admin/class-babilim-admin.php:1103
msgid "Removed."
msgstr "Forigita."

#: admin/class-babilim-admin.php:1139
msgid "Translation requested."
msgstr "Traduko petita."

#: admin/class-babilim-admin.php:1161
msgid "This component was already uploaded. Babilim is checking it now."
msgstr "Tiu komponanto jam estis alŝutita. Babilim kontrolas ĝin nun."

#: admin/class-babilim-admin.php:1201
msgid "Upload cancelled."
msgstr "Alŝuto nuligita."

#: admin/class-babilim-admin.php:1212
msgid "Upload complete — translation requested."
msgstr "Alŝuto finita — traduko petita."

#: admin/class-babilim-admin.php:1290
msgid "This component does not declare a version number, so a translation cannot be requested for it."
msgstr "Tiu komponanto ne deklaras versionumeron, do traduko ne povas esti petita por ĝi."

#. translators: %d: the most characters a version number may have.
#: admin/class-babilim-admin.php:1297
#, php-format
msgid "This component's version number is longer than %d characters, which Babilim cannot handle, so a translation cannot be requested for it."
msgstr "La versionumero de tiu komponanto estas pli longa ol %d signoj, kion Babilim ne povas trakti, do traduko ne povas esti petita por ĝi."

#: admin/class-babilim-admin.php:1303
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "Traduko ne povas esti petita por tiu lingvo en ĉi tiu retejo nuntempe."

#: admin/class-babilim-admin.php:1329
msgid "Thank you. Your report was sent."
msgstr "Dankon. Via raporto estis sendita."

#: admin/class-babilim-admin.php:1362
msgid "This report does not name a valid plugin or theme and locale."
msgstr "Ĉi tiu raporto ne enhavas validan Nomon de kromprogramo aŭ etoso kaj lingvo."

#: admin/class-babilim-admin.php:1366
msgid "Please choose a category for this report."
msgstr "Bonvolu elekti kategorion por ĉi tiu raporto."

#: admin/class-babilim-admin.php:1370
msgid "This report is missing a valid build to report against."
msgstr "Al ĉi tiu raporto mankas valida kompilaĵo, pri kiu raporti."

#: admin/class-babilim-admin.php:1373
msgid "This build is not one this site currently knows about for this component/locale."
msgstr "Ĉi tiu kompilaĵo ne estas konata de ĉi tiu retejo por ĉi tiu komponanto/lingvo."

#. translators: 1: the name of a form field, 2: how many characters it has, 3: the most characters it may have.
#: admin/class-babilim-admin.php:1425
#, php-format
msgid "The field \"%1$s\" is too long: it has %2$d characters and the limit is %3$d. Nothing was sent; please shorten it and try again."
msgstr "La kampo \"%1$s\" estas tro longa: ĝi havas %2$d signojn kaj la limo estas %3$d. Nenio estis sendita; bonvolu mallongigi ĝin kaj reprovi."

#: admin/class-babilim-admin.php:1450
msgid "Original string"
msgstr "Originala teksto"

#: admin/class-babilim-admin.php:1454
msgid "String context"
msgstr "Kunteksto de teksto"

#: admin/class-babilim-admin.php:1458
#: admin/class-babilim-admin.php:3945
msgid "Current translation"
msgstr "Nuna traduko"

#: admin/class-babilim-admin.php:1462
#: admin/class-babilim-admin.php:3947
msgid "Suggested translation"
msgstr "Sugestita traduko"

#: admin/class-babilim-admin.php:1466
#: admin/class-babilim-admin.php:3949
msgid "Note (optional)"
msgstr "Noto (nedeviga)"

#: admin/class-babilim-admin.php:1470
#: admin/class-babilim-admin.php:3951
msgid "Where you saw this (optional)"
msgstr "Kie vi vidis tion (nedeviga)"

#. translators: %s: the date and time syncing is expected to resume.
#: admin/class-babilim-admin.php:1517
#, php-format
msgid "Babilim sync is temporarily delayed by the service (rate limited); it will try again after %s."
msgstr "La sinkronigo de Babilim estas portempe prokrastita de la servo (limigo de petoj); ĝi reprovos post %s."

#. translators: %d: the most characters a locale code may have.
#: admin/class-babilim-admin.php:1552
#, php-format
msgid "The locale you added is not valid: use a WordPress locale code such as ll_CC (letters, digits, underscore, hyphen or @, at most %d characters). Nothing was saved."
msgstr "La aldonita lingvokodo ne validas: uzu WordPress-lingvokodon kiel ll_CC (literoj, ciferoj, substreko, streketo aŭ @, maksimume %d signoj). Nenio estis konservita."

#: admin/class-babilim-admin.php:1587
msgid "Settings saved."
msgstr "Agordoj konservitaj."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1649
#, php-format
msgid "If this is on, uninstalling also erases this site's identity. The paid license attached to this site cannot be restored automatically afterwards; you would have to contact Babilim support at %s to get it back."
msgstr "Se ĉi tio estas ŝaltita, malinstalado ankaŭ forigas la identecon de ĉi tiu retejo. La pagita licenco ligita al ĉi tiu retejo poste ne povas esti restarigita aŭtomate; vi devus kontakti Babilim-subtenon ĉe %s por rehavi ĝin."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1665
#, php-format
msgid "Babilim is set to erase this site's identity when the plugin is deleted. The paid license attached to this site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in the Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Babilim estas agordita forigi la identecon de ĉi tiu retejo kiam la kromprogramo estas forigita. La pagita licenco ligita al ĉi tiu retejo tiam ne povus esti restarigita aŭtomate; vi devus kontakti Babilim-subtenon ĉe %s. Por konservi la identecon, premu Nuligi, malmarku \"Forigi ĉiujn datumojn de Babilim ĉe malinstalado\" en la Babilim-agordoj, kaj malaktivigu denove. Ĉu malaktivigi tamen?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1690
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d retejo en ĉi tiu reto estas agordita forigi sian Babilim-identecon kiam la kromprogramo estas forigita. La pagita licenco ligita al tiu retejo tiam ne povus esti restarigita aŭtomate; vi devus kontakti Babilim-subtenon ĉe %2$s. Por konservi la identecon, premu Nuligi, malmarku \"Forigi ĉiujn datumojn de Babilim ĉe malinstalado\" en la Babilim-agordoj de tiu retejo, kaj malaktivigu denove. Ĉu malaktivigi tamen?"
msgstr[1] "%1$d retejoj en ĉi tiu reto estas agordITAJ forigi sian Babilim-identecon kiam la kromprogramo estas forigita. La pagita licenco ligita al tiuj retejoj tiam ne povus esti restarigita aŭtomate; vi devus kontakti Babilim-subtenon ĉe %2$s. Por konservi la identecojn, premu Nuligi, malmarku \"Forigi ĉiujn datumojn de Babilim ĉe malinstalado\" en la Babilim-agordoj de ĉiu retejo, kaj malaktivigu denove. Ĉu malaktivigi tamen?"

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1709
#, php-format
msgid "This network has too many sites to check them one by one, and some of them may be set to erase their Babilim identity when the plugin is deleted. The paid license attached to such a site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Ĉi tiu reto havas tro multajn retejojn por kontroli ilin unuope, kaj kelkaj el ili eble estas agorditaj forviŝi sian Babilim-identecon kiam la kromprogramo estas forigita. La pagita licenco ligita al tia retejo tiam ne povus esti restarigita aŭtomate; vi devus kontakti la Babilim-subtenon ĉe %s. Por konservi la identecojn, premu Nuligi, malmarku \"Forigi ĉiujn datumojn de Babilim ĉe malinstalado\" en la Babilim-agordoj de ĉiu retejo, kaj malaktivigu denove. Ĉu malaktivigi tamen?"

#: admin/class-babilim-admin.php:1798
msgid "Open Babilim settings"
msgstr "Malfermi la Babilim-agordojn"

#: admin/class-babilim-admin.php:1803
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Babilim ne povis kontroli ĉi tiun retejon, do nenio estas elŝutita aŭ instalita."

#: admin/class-babilim-admin.php:1815
msgid "The service could not reach your site. A firewall, security plugin or host rule is probably blocking the request; please allow requests to /wp-json/babilim/v1/challenge."
msgstr "La servo ne povis atingi vian retejon. Fajroŝirmilo, sekureca kromprogramo aŭ regulo de la gastiganto verŝajne blokas la peton; bonvolu permesi petojn al /wp-json/babilim/v1/challenge."

#: admin/class-babilim-admin.php:1817
msgid "Your site took too long to answer. Please try again later, and check that your host is not too slow or overloaded."
msgstr "Via retejo respondis tro malrapide. Bonvolu reprovi poste, kaj kontrolu ĉu via gastiganto ne estas tro malrapida aŭ troŝarĝita."

#: admin/class-babilim-admin.php:1819
msgid "Your site answered, but not with what was expected. The REST API may be rewritten by another plugin, or that endpoint may be cached; please exclude /wp-json/babilim/v1/challenge from caching and rewriting."
msgstr "Via retejo respondis, sed ne per la atendata enhavo. La REST-API eble estas reskribita de alia kromprogramo, aŭ tiu finpunkto eble estas kaŝmemorigita; bonvolu ekskludi /wp-json/babilim/v1/challenge el kaŝmemorado kaj reskribado."

#: admin/class-babilim-admin.php:1821
msgid "Please check that your site can be reached from the internet, then try again."
msgstr "Bonvolu kontroli ĉu via retejo estas atingebla de la interreto, poste reprovu."

#: admin/class-babilim-admin.php:1844
msgid "Re-verify"
msgstr "Re-kontroli"

#. translators: 1: number of components left out, 2: number of locales left out.
#: admin/class-babilim-admin.php:1865
#, php-format
msgid "This site is over the size the service accepts in one sync, so some items were left out: %1$d components and %2$d locales."
msgstr "Ĉi tiu retejo superas la grandecon kiun la servo akceptas en unu sinkronigo, do kelkaj eroj estis preterlasitaj: %1$d komponantoj kaj %2$d lokaĵaroj."

#: admin/class-babilim-admin.php:1894
msgid "This site is verified."
msgstr "Ĉi tiu retejo estas kontrolita."

#: admin/class-babilim-admin.php:1907
msgid "Registration restarted."
msgstr "Registrado rekomencita."

#: admin/class-babilim-admin.php:1928
#: admin/class-babilim-admin.php:1994
msgid "Sync complete."
msgstr "Sinkronigo finita."

#: admin/class-babilim-admin.php:1955
msgid "Babilim is enabling and checking this site… Reload this page or wait for the scheduled check to finish."
msgstr "Babilim ebligas kaj kontrolas ĉi tiun retejon… Reŝargu ĉi tiun paĝon aŭ atendu ke la planita kontrolo finiĝu."

#. translators: 1: short name of the step that failed, 2: the message for that failure.
#: admin/class-babilim-admin.php:1960
#, php-format
msgid "Babilim could not finish enabling (%1$s): %2$s"
msgstr "Babilim ne povis fini la ebligon (%1$s): %2$s"

#: admin/class-babilim-admin.php:1965
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "Gastiganto kiu servas nur unu PHP-peton samtempe ne povas plenumi ĉi tiun paŝon."

#. translators: %d: number of components found on this site.
#: admin/class-babilim-admin.php:1986
#, php-format
msgid "Babilim is enabled: this site is verified and %d component was found."
msgid_plural "Babilim is enabled: this site is verified and %d components were found."
msgstr[0] "Babilim estas ebligita: ĉi tiu retejo estas kontrolita kaj %d komponanto estis trovita."
msgstr[1] "Babilim estas ebligita: ĉi tiu retejo estas kontrolita kaj %d komponantoj estis trovitaj."

#: admin/class-babilim-admin.php:2062
msgid "Babilim is disabled. Nothing more is sent; translations already installed keep working."
msgstr "Babilim estas malebligita. Nenio plu estas sendata; jam instalitaj tradukoj daŭre funkcias."

#: admin/class-babilim-admin.php:2084
msgid "Supplementary translation index rebuilt."
msgstr "Suplementa indekso de tradukoj rekonstruita."

#. translators: %d: number of files deleted by this sweep.
#: admin/class-babilim-admin.php:2102
#, php-format
msgid "Sweep complete: %d file deleted."
msgid_plural "Sweep complete: %d files deleted."
msgstr[0] "Skanado finita: %d dosiero forigita."
msgstr[1] "Skanado finita: %d dosieroj forigitaj."

#. translators: %d: number of components removed.
#: admin/class-babilim-admin.php:2134
#, php-format
msgid "Removed %d installed component."
msgid_plural "Removed %d installed components."
msgstr[0] "Forigita %d instalita komponanto."
msgstr[1] "Forigitaj %d instalitaj komponantoj."

#: admin/class-babilim-admin.php:2136
msgid "Automatic installs are now off; turn them on again in the settings if you want them."
msgstr "Aŭtomataj instaladoj nun estas malŝaltitaj; ŝaltu ilin denove en la agordoj se vi volas ilin."

#: admin/class-babilim-admin.php:2455
msgid "Babilim finds the plugins and themes on this site that have no translation for your language and installs one for each."
msgstr "Babilim trovas la kromprogramojn kaj temojn en ĉi tiu retejo kiuj ne havas tradukon por via lingvo kaj instalas unu por ĉiu."

#. translators: %s: a list of language names, joined the way the language joins lists.
#: admin/class-babilim-admin.php:2463
#, php-format
msgid "Languages found on this site: %s."
msgstr "Lingvoj trovitaj en ĉi tiu retejo: %s."

#: admin/class-babilim-admin.php:2468
msgid "Available translations can be installed with one click, and missing ones can be requested. After that, new translations and updates are installed automatically (on the free plan, only for plugins and themes that already use a free slot)."
msgstr "Disponeblaj tradukoj povas esti instalitaj per unu klako, kaj mankantaj povas esti petitaj. Poste, novaj tradukoj kaj ĝisdatigoj estas instalitaj aŭtomate (en la senpaga plano, nur por kromprogramoj kaj temoj kiuj jam uzas senpagan lokon)."

#: admin/class-babilim-admin.php:2469
msgid "The free plan covers a limited number of plugins and themes; your exact quota is shown in Settings after you enable Babilim."
msgstr "La senpaga plano kovras limigitan nombron da kromprogramoj kaj temoj; via preciza kvoto estas montrata en Agordoj post kiam vi ebligas Babilim."

#: admin/class-babilim-admin.php:2470
msgid "What is sent when you enable Babilim"
msgstr "Kio estas sendata kiam vi ebligas Babilim"

#: admin/class-babilim-admin.php:2474
msgid "Enabling…"
msgstr "Ebligado…"

#: admin/class-babilim-admin.php:2474
msgid "Enable Babilim"
msgstr "Ebligi Babilim"

#: admin/class-babilim-admin.php:2475
msgid "By clicking Enable, you agree to send the information listed above to Babilim."
msgstr "Klakante Ebligi, vi konsentas sendi la supre listigitajn informojn al Babilim."

#: admin/class-babilim-admin.php:2509
#: admin/class-babilim-admin.php:2551
#: admin/class-babilim-admin.php:3831
msgid "Check again now"
msgstr "Kontroli denove nun"

#. translators: %d: how many translations were installed automatically.
#: admin/class-babilim-admin.php:2524
#, php-format
msgid "Babilim installed %d translation automatically since your last visit."
msgid_plural "Babilim installed %d translations automatically since your last visit."
msgstr[0] "Babilim aŭtomate instalis %d tradukon ekde via lasta vizito."
msgstr[1] "Babilim aŭtomate instalis %d tradukojn ekde via lasta vizito."

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:2544
#, php-format
msgid "Babilim is enabling and checking this site… (last attempt: %s)"
msgstr "Babilim ebligas kaj kontrolas ĉi tiun retejon… (lasta provo: %s)"

#: admin/class-babilim-admin.php:2548
msgid "Check again"
msgstr "Kontroli denove"

#: admin/class-babilim-admin.php:2561
msgid "No components synced yet."
msgstr "Ankoraŭ neniu komponanto sinkronigita."

#. translators: %d: how many items succeeded.
#: admin/class-babilim-admin.php:2582
#, php-format
msgid "%d succeeded"
msgid_plural "%d succeeded"
msgstr[0] "%d sukcesis"
msgstr[1] "%d sukcesis"

#. translators: %d: how many items were skipped.
#: admin/class-babilim-admin.php:2586
#, php-format
msgid "%d skipped"
msgid_plural "%d skipped"
msgstr[0] "%d preterlasita"
msgstr[1] "%d preterlasitaj"

#. translators: %d: how many items failed.
#: admin/class-babilim-admin.php:2590
#, php-format
msgid "%d failed"
msgid_plural "%d failed"
msgstr[0] "%d malsukcesis"
msgstr[1] "%d malsukcesis"

#. translators: %d: how many items were not tried yet.
#: admin/class-babilim-admin.php:2594
#, php-format
msgid "%d not yet tried"
msgid_plural "%d not yet tried"
msgstr[0] "%d ankoraŭ ne provita"
msgstr[1] "%d ankoraŭ ne provitaj"

#. translators: %s: the bulk action (download, update or request).
#: admin/class-babilim-admin.php:2597
#, php-format
msgid "Bulk %s:"
msgstr "Amasa %s:"

#. translators: 1: the "Bulk <action>:" lead-in.
#: admin/class-babilim-admin.php:2600
#, php-format
msgid "%1$s nothing to do."
msgstr "%1$s nenio farenda."

#. translators: 1: the "Bulk <action>:" lead-in, 2: the counts, already joined into a list.
#: admin/class-babilim-admin.php:2603
#, php-format
msgid "%1$s %2$s."
msgstr "%1$s %2$s."

#. translators: 1: component name, 2: language name, 3: why the action failed.
#: admin/class-babilim-admin.php:2638
#, php-format
msgid "%1$s (%2$s): %3$s"
msgstr "%1$s (%2$s): %3$s"

#: admin/class-babilim-admin.php:2673
msgid "Continuing…"
msgstr "Daŭrigante…"

#. translators: %d: how many operations are left.
#: admin/class-babilim-admin.php:2676
#, php-format
msgid "Continue next batch (%d left)"
msgstr "Daŭrigi la sekvan aron (restas %d)"

#: admin/class-babilim-admin.php:2726
msgid "Search components"
msgstr "Serĉi komponantojn"

#. translators: %s: link to the Settings page, with the text "Settings".
#: admin/class-babilim-admin.php:2733
#, php-format
msgid "These are the languages this site uses. You can change them in %s."
msgstr "Ĉi tiuj estas la lingvoj uzataj de ĉi tiu retejo. Vi povas ŝanĝi ilin en %s."

#: admin/class-babilim-admin.php:2752
