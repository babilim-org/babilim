msgid_plural "Babilim installed %d translations automatically since your last visit."
msgstr[0] "Babilim paigaldas pärast teie viimast külastust automaatselt %d tõlke."
msgstr[1] "Babilim paigaldas pärast teie viimast külastust automaatselt %d tõlget."

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:2597
#, php-format
