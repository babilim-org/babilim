msgstr "ཁྱོད་ཀྱི་ WordPress ཐོན་རིམ། འཐུན་འཚམས་ཀྱི་ཡིག་སྒྱུར་ཡིག་སྣོད་ཚུ་བཀྲམ་སྤེལ་འབད་ནིའི་དོན་ལུ།"

#: includes/class-babilim-consent.php:82
msgid "Your PHP version, for compatibility."
msgstr "ཁྱོད་ཀྱི་ PHP ཐོན་རིམ་, མཐུན་འཚམས་ཀྱི་དོན་ལུ།"

#: includes/class-babilim-consent.php:87
msgid "This plugin's own version, so the service can tell you to update it if it's too old to talk to."
msgstr "ལག་ཆས་འདི་གི་རང་ཉིད་ཀྱི་ཐོན་རིམ། དེ་གིས་ཐོན་རིམ་རྙིང་དྲགས་སྦེ་ཞབས་ཏོག་དང་འབྲེལ་བ་འཐབ་མ་ཚུགསཔ་ད་ ཞབས་ཏོག་གིས་ཁྱེད་ལུ་ཐོན་རིམ་གསར་བསྒྱུར་འབད་ནིའི་བརྡ་བསྐུལ་འབད་ཚུགས།"

#: includes/class-babilim-consent.php:92
msgid "This site's configured locale."
msgstr "དྲ་ཚིགས་འདིའི་སྒྲིག་འགོད་འབད་ཡོད་པའི་སྐད་ཡིག་ས་ཁོངས།"

#: includes/class-babilim-consent.php:97
msgid "Every locale in use on this site (site locale, installed language packs, user locales, and any you add manually). No locale is treated differently from another."
msgstr "དྲ་ཚིགས་འདི་ནང་ལག་ལེན་འཐབ་མི་སྐད་ཡིག་ས་ཁོངས་ཚུ་ག་ར་ (དྲ་ཚིགས་ཀྱི་སྐད་ཡིག་ས་ཁོངས་, གཞི་བཙུགས་འབད་ཡོད་པའི་སྐད་ཡིག་ཐུམ་སྒྲིལ་, ལག་ལེན་པའི་སྐད་ཡིག་ས་ཁོངས་, དང་ཁྱོད་ཀྱིས་ལག་པ་གིས་ཁ་སྣོན་འབད་མི་ཚུ)། སྐད་ཡིག་ས་ཁོངས་གང་ཡང་གཞན་ལས་ཁྱད་པར་མེད་པར་བརྩི།"

#: includes/class-babilim-consent.php:101
msgid "(a public key generated for this site)"
msgstr "(དྲ་ཚིགས་འདིའི་དོན་ལུ་བཟོ་མི་སྤྱི་འདོན་ལྡེ་མིག)"

#: includes/class-babilim-consent.php:102
msgid "This site's install public key, used to prove requests genuinely come from this site. Only the public half is ever sent."
msgstr "དྲ་ཚིགས་འདིའི་གཞི་བཙུགས་སྤྱི་འདོན་ལྡེ་མིག་, རེ་བ་ཚུ་དྲ་ཚིགས་འདི་ལས་ཐད་ཀར་ཡོང་མི་ཨིན་པའི་ཁུངས་སྐྱེལ་ནིའི་དོན་ལུ་ལག་ལེན་འཐབ་ཨིན། སྤྱི་འདོན་ཕྱེད་ཀ་རྐྱངམ་ཅིག་གཏང་ཨིན།"

#: includes/class-babilim-consent.php:107
msgid "Every installed plugin/theme: its slug, version, text domain(s), whether it's a wp.org listing, its own bundled locales, and which locales you've already installed a Babilim translation for."
msgstr "གཞི་བཙུགས་འབད་ཡོད་པའི་ plugin/theme ག་ར་: དེའི་ slug, ཐོན་རིམ་, text domain, དེ་ WordPress.org གི་ཐོ་ཡིག་ཅིག་ཨིན་མིན་, དེའི་རང་གི་ཐུམ་སྒྲིལ་འབད་ཡོད་པའི་སྐད་ཡིག་ས་ཁོངས་, དང་ཁྱོད་ཀྱིས་ Babilim ཡིག་སྒྱུར་གཞི་བཙུགས་འབད་ཚར་མི་སྐད་ཡིག་ས་ཁོངས་ཚུ།"

#: includes/class-babilim-consent.php:112
msgid "Only when you confirm an upload for a plugin or theme that is not on WordPress.org: that component's entire directory, as a zip."
msgstr "WordPress.org ནང་མེད་པའི་ པླག་ཨིན་ ཡང་ན་ ཐིམ་ཅིག་གི་ཡར་བསྐྱལ་ཁྱོད་ཀྱིས་ངེས་བརྟན་འབད་པའི་སྐབས་རྐྱངམ་ཅིག: ཆ་ཤས་དེའི་སྣོད་ཐོ་ཧྲིལ་པོ་ zip སྦེ།"

#: includes/class-babilim-consent.php:116
msgid "(generic codes and coordinates only)"
msgstr "(སྤྱིར་བཏང་གི་ཨང་རྟགས་དང་ས་ཁྲ་ཡི་ཆ་སྙོམས་ཨང་རྐྱངམ་ཅིག)"

#: includes/class-babilim-consent.php:117
msgid "Up to 20 pending diagnostic events (e.g. a file that failed its integrity check), each just a code, component, and locale, and never any string content or translated text."
msgstr "ཞིབ་དཔྱད་བྱུང་རིམ་སྒུག་བསྡད་པ་ ༢༠ ཚུན་ (དཔེར་ན་ ཡིག་སྣོད་ཅིག་གིས་ཆ་ཚང་བའི་ཞིབ་དཔྱད་ལུ་ཕམ་པ), རེ་རེ་བཞིན་ཨང་རྟགས་, ཆ་ཤས་, དང་སྐད་ཡིག་ས་ཁོངས་རྐྱངམ་ཅིག་ཨིནམ་དང་, ཡིག་རྒྱུན་ནང་དོན་ཡང་ན་ཡིག་སྒྱུར་འབད་ཡོད་པའི་ཚིག་གང་ཡང་ནམ་ཡང་མེད།"

