msgid "The upload is kept until you ask Babilim to delete it."
msgstr "ཁྱོད་ཀྱིས་ Babilim ལུ་བཏོན་གཏང་ནིའི་ཞུ་བ་མ་བཀོད་ཚུན་ ཡར་སྐྱེལ་འདི་ཉར་ཚགས་འབད་ཡོད།"

#: admin/class-babilim-admin.php:2763
msgid "It is stored by the service's hosting provider and processed by AI models to produce the translation."
msgstr "འདི་ ཞབས་ཏོག་གི་ཧོསྟིང་མཁོ་སྤྲོད་པས་ཉར་ཚགས་འབད་ཞིནམ་ལས་ ཡིག་སྒྱུར་བཟོ་ནི་ལུ་ AI དཔེ་དབྱིབས་ཚུགིས་ལས་སྦྱོར་འབདཝ་ཨིན།"

