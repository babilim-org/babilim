msgstr "ངེས་དཔྱད་ཀྱི་ལན་ནང་ site_token བརླག་སྟེ་ཡོད།"

#: includes/class-babilim-site.php:735
msgid "No site id is on file to rotate a token for."
msgstr "ཊོཀ་ཀེན་བསྒྱུར་ནིའི་དོན་ལུ་ ཐོ་བཀོད་འབད་ཡོད་པའི་དྲྭ་ས་ཁོངས་ཀྱི་ id མིན་འདུག"

#: includes/class-babilim-site.php:744
msgid "Rotate-token response was missing site_token."
msgstr "ཊོཀ་ཀེན་བསྒྱུར་བའི་ལན་ནང་ site_token བརླག་སྟེ་ཡོད།"

#: includes/class-babilim-site.php:781
#: includes/class-babilim-site.php:786
msgid "nonce must be a hexadecimal string."
msgstr "nonce འདི་ ཧེགསད་ཨེསི་མཱལ་ཡིག་ཕྲེང་ཅིག་ཨིན་དགོ།"

#: includes/class-babilim-site.php:805
msgid "No pending challenge for this nonce."
msgstr "nonce འདི་གི་དོན་ལུ་ བསྒུག་སྡོད་མི་ challenge མིན་འདུག"

#: includes/class-babilim-site.php:808
msgid "Too many requests."
msgstr "ཞུ་བ་ཧ་ཅང་མང་དྲག།"

#. translators: 1: number of components, 2: number of languages, 3: number of check batches needed, 4: the most batches one run can send.
#: includes/class-babilim-site.php:902
#, php-format
msgid "This site has %1$d components across %2$d languages, which needs %3$d check batches; Babilim can handle at most %4$d per run. Reduce the managed languages in Settings or deactivate unused plugins and themes, then press Check again now."
msgstr "དྲྭ་ས་ཁོངས་འདི་ལུ་ སྐད་ཡིག་%2$d ནང་ ཆ་ཤས་%1$d ཡོད་པས་ ཞིབ་དཔྱད་ཚོགས་%3$d དགོ། Babilim གིས་ གཡོག་བཀོལ་རེ་ལུ་ མང་མཐའ་%4$d རྐྱངམ་ཅིག་འབད་ཚུགས། སྒྲིག་བཀོད་ནང་ འཛིན་སྐྱོང་འབད་མི་སྐད་ཡིག་ཉུང་ཅུང་བཟོ་ཡང་ན་ ལག་ལེན་མེད་པའི་ པླག་ཨིན་དང་ ཐིམ་ཚུ་ལག་ལེན་མེདཔ་བཟོ་ཞིན་ཏེ་ ད་ལྟ་ ཚར་གཅིག་ཞིབ་དཔྱད་ཨེབ།"

#: includes/class-babilim-site.php:977
msgid "Babilim could not finish checking this site."
msgstr "Babilim གིས་ ཝེབ་ས་ཚིགས་འདི་ཞིབ་དཔྱད་འབད་ཚར་མ་ཚུགས།"

#: includes/class-babilim-site.php:1472
msgid "This site's address is too long for Babilim to register."
msgstr "ཝེབ་ས་ཚིགས་འདི་གི་ཁ་བྱང་ ཧ་ཅང་རིང་པས་ Babilim གིས་ཐོ་འགོད་འབད་མི་ཚུགས།"

#: includes/class-babilim-site.php:1475
msgid "This site's locale code is not one Babilim can register."
msgstr "ཝེབ་ས་ཚིགས་འདི་གི་སྐད་ཡིག་ས་ཁོངས་ཀྱི་ཨང་རྟགས་འདི་ Babilim གིས་ཐོ་འགོད་འབད་མི་ཚུགས།"

#: includes/class-babilim-sync-installer.php:330
msgid "The download response was missing a usable location."
msgstr "ཕབ་ལེན་གྱི་ལན་ནང་ ལག་ལེན་འཐབ་ཚུགས་པའི་ས་གནས་མ་འདུག"

#: includes/class-babilim-upload.php:64
msgid "The service's upload offer was incomplete."
msgstr "ཞབས་ཏོག་གིས་བྱིན་མི་ཡར་སྐྱེལ་གྱི་ལམ་སྟོན་འདི་ཆ་མ་ཚང་པས།"

#: includes/class-babilim-upload.php:104
msgid "This component is larger than the service accepts, so it cannot be uploaded."
msgstr "ཆ་ཤས་འདི་ ཞབས་ཏོག་གིས་ངོས་ལེན་འབད་མི་ལས་ཆེ་བས་ སྤྲོད་འབུལ་འབད་མི་ཚུགས།"

#: includes/class-babilim-upload.php:148
msgid "The packaged component could not be read."
msgstr "ཐུམ་སྒྲིལ་འབད་ཡོད་པའི་ཆ་ཤས་ལྷག་མ་ཚུགས།"

#: includes/class-babilim-upload.php:259
msgid "A part of the upload kept failing, so the upload was cancelled."
msgstr "ཡར་སྐྱེལ་གྱི་ཆ་ཤས་ཅིག་ ལོག་ལོག་འཐུས་ཤོར་བས་ ཡར་སྐྱེལ་འདི་ ཆ་མེད་བཟོ་ཡི།"

