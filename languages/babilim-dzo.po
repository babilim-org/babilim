#: includes/class-babilim-default-index.php:109
#: includes/class-babilim-installer.php:949
#, php-format
msgid "Unsafe locale: %s"
msgstr "བདེ་འཇགས་མེད་པའི་སྐད་ཡིག་ས་ཁོངས: %s"

