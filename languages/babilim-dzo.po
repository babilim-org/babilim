#. translators: %s: the locale code the merged index was built for.
#: includes/class-babilim-default-index.php:874
#, php-format
msgid "The merged index for '%s' was rebuilt, but the translation index could not record it; the next rebuild will retry."
msgstr "'%s' གི་མཉམ་སྡེབ་སྟོན་གྲངས་ སླར་བཟོ་ཚར་ཡི། འོན་ཀྱང་ ཡིག་སྒྱུར་གྱི་སྟོན་གྲངས་ཀྱིས་ཐོ་བཀོད་འབད་མ་ཐུབ། ཤུལ་མམ་གྱི་སླར་བཟོ་འབད་བའི་སྐབས་ ལོག་ཚོད་ལྟ་འབད་འོང་།"

