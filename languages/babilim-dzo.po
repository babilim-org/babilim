msgstr "Manifest ཐོབ་མི་ཚུགས: %s"

#: includes/class-babilim-default-index.php:134
msgid "Could not determine active components; the existing merged index was left unchanged."
msgstr "ལག་ལེན་ཅན་གྱི་ཆ་ཤས་ཚུ་ངོས་འཛིན་འབད་མ་ཚུགས། ཟླ་སྒྲིག་འབད་ཡོད་པའི་ཐོ་ཡིག་ཐོག་ལུ་འགྱུར་བ་མ་བཏང་བར་བཞག་ཅི།"

#: includes/class-babilim-default-index.php:399
msgid "Could not determine installed plugins/themes; sweep skipped, nothing was deleted."
msgstr "གཞི་བཙུགས་འབད་ཡོད་པའི་ plugin/theme ཚུ་ངོས་འཛིན་འབད་མ་ཚུགས། གཙང་བསལ་ཕྱིར་བཞག་ཅི། ཅི་ཡང་བསུབས་མ་སོངས།"

#. translators: %s: the technical reason the sweep was aborted.
#: includes/class-babilim-default-index.php:531
#, php-format
msgid "Sweep aborted without orphaning anything: %s."
msgstr "གཙང་བསལ་འདི་ ཅིག་ཡང་འབྲེལ་བ་མ་ཆད་པར་བཀག་ཆད་བྱུང་: %s།"

#: includes/class-babilim-default-index.php:622
msgid "The cleanup ran, but some of its changes could not be recorded in the translation index; the next cleanup will retry them."
msgstr "གཙང་བཟོ་འབད་ཡི། འོན་ཀྱང་དེའི་འགྱུར་བ་ལ་ལོ་ཅིག་ཡིག་སྒྱུར་ཐོ་ཡིག་ནང་ཐོ་བཀོད་འབད་མ་ཚུགས། གཙང་བཟོ་ཤུལ་མམ་གྱིས་ཕྱིར་ཚོད་ལྟ་འབདཝ་ཨིན།"

#. translators: %s: the locale code the merged index was built for.
#: includes/class-babilim-default-index.php:814
#, php-format
msgid "The merged index for '%s' was rebuilt, but the translation index could not record it; the next rebuild will retry."
msgstr "'%s' གི་དོན་ལུ་མཉམ་སྒྲིག་ཐོ་ཡིག་བསྐྱར་བཟོ་འབད་ཡི། འོན་ཀྱང་ཡིག་སྒྱུར་ཐོ་ཡིག་ནང་ཐོ་བཀོད་འབད་མ་ཚུགས། ཤུལ་མའི་བསྐྱར་བཟོའི་སྐབས་ ལོག་རྩོལ་འབད་འོང་།"

#: includes/class-babilim-default-index.php:890
msgid "Could not write the staged merged index."
msgstr "གནས་སྒྲིག་འབད་ཡོད་པའི་ཟླ་སྒྲིག་ཐོ་ཡིག་འབྲི་མ་ཚུགས།"

#: includes/class-babilim-default-index.php:898
msgid "Re-parsed entry count did not match the built index."
msgstr "ལོག་དབྱེ་ཞིབ་འབད་ཡོད་པའི་ཐོ་གྲངས་འདི་ བཟོ་ཡོད་པའི་ཐོ་ཡིག་དང་མཐུན་མ་སོང་།"

#. translators: %s: the locale code the merged index was built for.
#: includes/class-babilim-default-index.php:929
#, php-format
msgid "Could not move the merged index for '%s' into place; the previous served index (if any) was removed rather than left half-updated. No default-domain supplement is served for this locale until the next successful rebuild."
msgstr "'%s' གི་དོན་ལུ་ མཉམ་སྦྱོར་འབད་ཡོད་པའི་ཐོ་ཡིག་ གནས་ཁུལ་འདི་ནང་བཞག་མ་ཚུགས། ཕྱེད་ཀ་རྐྱངམ་ཅིག་གསར་བཅོས་འབད་མི་ཐོ་ཡིག་ཅིག་མ་བཞག་པར་ ཧེ་མའི་ཐོ་ཡིག་ (ཡོད་པ་ཅིན་) བསུབས་ཡི། ཤུལ་མམ་གྱི་བསྐྱར་བཟོ་མཐར་འཁྱོལ་ཚུན་ སྐད་ཡིག་ས་ཁོངས་འདི་གི་དོན་ལུ་ default-domain གི་ཁ་སྐོང་མི་སྤྲོད།"

#. translators: %s: the zip file path that could not be opened.
#: includes/class-babilim-installer.php:147
#, php-format
msgid "Could not open zip: %s"
msgstr "zip ཁ་ཕྱེ་མ་ཚུགས: %s"

#: includes/class-babilim-installer.php:150
msgid "Zip has no manifest.json."
msgstr "Zip ནང་ manifest.json མེད།"

#: includes/class-babilim-installer.php:161
msgid "manifest.json in the zip is not valid JSON."
msgstr "zip ནང་གི་ manifest.json དེ་ནུས་ལྡན་ JSON མིན་འདུག"

#. translators: %s: the manifest.json field that did not match.
#: includes/class-babilim-installer.php:165
#, php-format
msgid "manifest.json's '%s' does not match the expected value."
msgstr "manifest.json གི་ '%s' དེ་རེ་བའི་གནས་གོང་དང་མཐུན་མ་སོང་།"

#: includes/class-babilim-installer.php:249
#: includes/class-babilim-installer.php:254
msgid "Another installation is running; try again in a moment."
msgstr "གཞི་བཙུགས་གཞན་ཅིག་འབད་བའི་སྒང་ཨིན། སྐར་མ་འགའ་ཅིག་གི་ཤུལ་ལས་ལོག་ཚོད་ལྟ་འབད།"

#. translators: %s: the invalid server_build_id value.
#: includes/class-babilim-installer.php:296
#, php-format
msgid "Not a valid server_build_id: %s"
msgstr "ནུས་ལྡན་ server_build_id མིན་འདུག: %s"

#. translators: 1: the package manifest's own kind. 2: the requested kind.
#: includes/class-babilim-installer.php:311
#, php-format
msgid "The package manifest's kind '%1$s' does not match the requested kind '%2$s'."
msgstr "ཐུམ་སྒྲིལ་གྱི་ཐོ་ཡིག་གི་ kind '%1$s' དེ་ཞུ་བའི་ kind '%2$s' དང་མཐུན་མ་སོང་།"

#. translators: 1: the package's text domain. 2: this site's text domain for the component.
#: includes/class-babilim-installer.php:346
#, php-format
msgid "The package's text domain '%1$s' does not match this site's copy of the component ('%2$s'), so it was not installed."
msgstr "ཐུམ་སྒྲིལ་གྱི་ text domain '%1$s' དེ་དྲ་ཚིགས་འདིའི་ཆ་ཤས་ཀྱི་འདྲ་བཤུས་ ('%2$s') དང་མཐུན་མ་སོངམ་ལས་ གཞི་བཙུགས་མ་འབད།"

#. translators: 1: the given domain. 2: the package manifest's own slug. 3: the package manifest's own text_domain.
#: includes/class-babilim-installer.php:364
#, php-format
msgid "The given domain '%1$s' matches neither the package manifest's own slug '%2$s' nor its text_domain '%3$s'."
msgstr "བྱིན་ཡོད་པའི་ domain '%1$s' དེ་ཐུམ་སྒྲིལ་གྱི་ཐོ་ཡིག་གི་རང་གི་ slug '%2$s' དང་ text_domain '%3$s' གཉིས་ཆ་ར་དང་མཐུན་མ་སོང་།"

#. translators: %s: the invalid slug.
#: includes/class-babilim-installer.php:372
#, php-format
msgid "Unsafe slug: %s"
msgstr "བདེ་འཇགས་མེད་པའི་ slug: %s"

#. translators: %s: the invalid text domain.
#: includes/class-babilim-installer.php:375
