#: includes/class-babilim-site.php:434
#: includes/class-babilim-sync-installer.php:316
msgid "Babilim could not verify this site, so nothing is downloaded or installed until verification succeeds."
msgstr "Babilim သည် ဤဆိုက်ကို အတည်မပြုနိုင်ခဲ့သဖြင့် အတည်ပြုမှု အောင်မြင်သည်အထိ မည်သည့်အရာကိုမျှ ဒေါင်းလုဒ် သို့မဟုတ် ထည့်သွင်းမည်မဟုတ်ပါ။"

#: includes/class-babilim-site.php:530
#: includes/class-babilim-site.php:643
msgid "Registration response was missing required fields."
msgstr "စာရင်းသွင်းမှု တုံ့ပြန်ချက်တွင် လိုအပ်သော အကွက်များ ပျောက်နေသည်။"

#: includes/class-babilim-site.php:536
#: includes/class-babilim-site.php:650
msgid "No pending challenge to verify."
msgstr "အတည်ပြုရန် ဆိုင်းငံ့ထားသည့် စိန်ခေါ်မှု မရှိပါ။"

#: includes/class-babilim-site.php:574
msgid "Verify response was missing site_token."
msgstr "အတည်ပြုမှု တုံ့ပြန်ချက်တွင် site_token ပျောက်နေသည်။"

#: includes/class-babilim-site.php:735
msgid "No site id is on file to rotate a token for."
msgstr "တိုကင်ပြောင်းရန်အတွက် ဖိုင်တွင် မှတ်တမ်းတင်ထားသော ဆိုက် ID မရှိပါ။"

#: includes/class-babilim-site.php:744
msgid "Rotate-token response was missing site_token."
msgstr "တိုကင်ပြောင်းလဲမှု တုံ့ပြန်ချက်တွင် site_token ပျောက်နေသည်။"

#: includes/class-babilim-site.php:781
#: includes/class-babilim-site.php:786
msgid "nonce must be a hexadecimal string."
