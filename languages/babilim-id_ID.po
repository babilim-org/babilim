msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Melengkapi terjemahan yang hilang untuk plugin dan tema yang sudah terpasang di situs Anda."

#: admin/class-babilim-admin.php:320
#: admin/class-babilim-admin.php:321
#: admin/class-babilim-translations-table.php:400
msgid "Translations"
msgstr "Terjemahan"

#: admin/class-babilim-admin.php:328
msgid "Babilim Settings"
msgstr "Pengaturan Babilim"

#: admin/class-babilim-admin.php:329
#: admin/class-babilim-admin.php:2510
#: admin/class-babilim-admin.php:2734
msgid "Settings"
msgstr "Pengaturan"

#: admin/class-babilim-admin.php:356
#: admin/class-babilim-admin.php:763
msgid "You are not allowed to do this."
msgstr "Anda tidak diizinkan melakukan ini."

#. translators: 1: the most operations one run accepts, 2: how many were selected.
#: admin/class-babilim-admin.php:385
#, php-format
msgid "Select fewer components: at most %1$d operations per run (you selected %2$d)."
msgstr "Pilih lebih sedikit komponen: maksimal %1$d operasi per proses (Anda memilih %2$d)."

#: admin/class-babilim-admin.php:398
#: admin/class-babilim-admin.php:1116
#: admin/class-babilim-admin.php:1287
msgid "That component is not installed on this site, so a translation cannot be requested for it."
msgstr "Komponen itu tidak terpasang di situs ini, sehingga terjemahan tidak dapat diminta untuknya."

#: admin/class-babilim-admin.php:917
msgid "Already installed."
msgstr "Sudah terpasang."

#: admin/class-babilim-admin.php:917
msgid "Downloaded and installed."
msgstr "Diunduh dan dipasang."

#: admin/class-babilim-admin.php:940
#: admin/class-babilim-admin.php:1281
#: admin/class-babilim-admin.php:1357
#: admin/class-babilim-admin.php:1922
#: admin/class-babilim-admin.php:2070
#: includes/class-babilim-api-client.php:519
#: includes/class-babilim-site.php:311
#: includes/class-babilim-site.php:362
#: includes/class-babilim-site.php:705
#: includes/class-babilim-site.php:838
msgid "Babilim has not been enabled for this site yet."
msgstr "Babilim belum diaktifkan untuk situs ini."

#: admin/class-babilim-admin.php:959
msgid "No build is available to download for this locale."
msgstr "Tidak ada build yang tersedia untuk diunduh untuk lokal ini."

#: admin/class-babilim-admin.php:1014
msgid "Rolled back to the previous build."
msgstr "Dikembalikan ke build sebelumnya."

#: admin/class-babilim-admin.php:1073
msgid "Rolled back and reported."
msgstr "Dikembalikan dan dilaporkan."

#. translators: %s: why sending the report failed.
#: admin/class-babilim-admin.php:1079
#, php-format
msgid "Rolled back, but the report could not be sent: %s"
msgstr "Dikembalikan, tetapi laporan tidak dapat dikirim: %s"

#: admin/class-babilim-admin.php:1103
msgid "Removed."
msgstr "Dihapus."

#: admin/class-babilim-admin.php:1139
msgid "Translation requested."
msgstr "Terjemahan diminta."

#: admin/class-babilim-admin.php:1161
msgid "This component was already uploaded. Babilim is checking it now."
msgstr "Komponen ini sudah diunggah. Babilim sedang memeriksanya sekarang."

#: admin/class-babilim-admin.php:1201
msgid "Upload cancelled."
msgstr "Unggahan dibatalkan."

#: admin/class-babilim-admin.php:1212
msgid "Upload complete — translation requested."
msgstr "Unggahan selesai — terjemahan diminta."

#: admin/class-babilim-admin.php:1290
msgid "This component does not declare a version number, so a translation cannot be requested for it."
msgstr "Komponen ini tidak mencantumkan nomor versi, sehingga terjemahan tidak dapat diminta untuknya."

#. translators: %d: the most characters a version number may have.
#: admin/class-babilim-admin.php:1297
#, php-format
msgid "This component's version number is longer than %d characters, which Babilim cannot handle, so a translation cannot be requested for it."
msgstr "Nomor versi komponen ini lebih panjang dari %d karakter, yang tidak dapat ditangani Babilim, sehingga terjemahan tidak dapat diminta untuknya."

#: admin/class-babilim-admin.php:1303
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "Terjemahan tidak dapat diminta untuk lokal itu di situs ini saat ini."

#: admin/class-babilim-admin.php:1329
msgid "Thank you. Your report was sent."
msgstr "Terima kasih. Laporan Anda telah dikirim."

#: admin/class-babilim-admin.php:1362
msgid "This report does not name a valid plugin or theme and locale."
msgstr "Laporan ini tidak menyebutkan nama plugin atau tema dan lokal yang valid."

#: admin/class-babilim-admin.php:1366
msgid "Please choose a category for this report."
msgstr "Silakan pilih kategori untuk laporan ini."

#: admin/class-babilim-admin.php:1370
msgid "This report is missing a valid build to report against."
msgstr "Laporan ini tidak memiliki build valid untuk dilaporkan."

#: admin/class-babilim-admin.php:1373
msgid "This build is not one this site currently knows about for this component/locale."
msgstr "Build ini bukan build yang saat ini dikenali situs ini untuk komponen/lokal ini."

#. translators: 1: the name of a form field, 2: how many characters it has, 3: the most characters it may have.
#: admin/class-babilim-admin.php:1425
#, php-format
msgid "The field \"%1$s\" is too long: it has %2$d characters and the limit is %3$d. Nothing was sent; please shorten it and try again."
msgstr "Kolom \"%1$s\" terlalu panjang: berisi %2$d karakter dan batasnya %3$d. Tidak ada yang dikirim; silakan persingkat lalu coba lagi."

#: admin/class-babilim-admin.php:1450
msgid "Original string"
msgstr "String asli"

#: admin/class-babilim-admin.php:1454
msgid "String context"
msgstr "Konteks string"

#: admin/class-babilim-admin.php:1458
#: admin/class-babilim-admin.php:3945
msgid "Current translation"
msgstr "Terjemahan saat ini"

#: admin/class-babilim-admin.php:1462
#: admin/class-babilim-admin.php:3947
msgid "Suggested translation"
msgstr "Terjemahan yang disarankan"

#: admin/class-babilim-admin.php:1466
#: admin/class-babilim-admin.php:3949
msgid "Note (optional)"
msgstr "Catatan (opsional)"

#: admin/class-babilim-admin.php:1470
#: admin/class-babilim-admin.php:3951
msgid "Where you saw this (optional)"
msgstr "Di mana Anda melihat ini (opsional)"

#. translators: %s: the date and time syncing is expected to resume.
#: admin/class-babilim-admin.php:1517
#, php-format
msgid "Babilim sync is temporarily delayed by the service (rate limited); it will try again after %s."
msgstr "Sinkronisasi Babilim sementara tertunda oleh layanan (dibatasi laju); akan dicoba lagi setelah %s."

#. translators: %d: the most characters a locale code may have.
#: admin/class-babilim-admin.php:1552
#, php-format
msgid "The locale you added is not valid: use a WordPress locale code such as ll_CC (letters, digits, underscore, hyphen or @, at most %d characters). Nothing was saved."
msgstr "Lokal yang Anda tambahkan tidak valid: gunakan kode lokal WordPress seperti ll_CC (huruf, angka, garis bawah, tanda hubung, atau @, maksimal %d karakter). Tidak ada yang disimpan."

#: admin/class-babilim-admin.php:1587
msgid "Settings saved."
msgstr "Pengaturan disimpan."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1649
#, php-format
msgid "If this is on, uninstalling also erases this site's identity. The paid license attached to this site cannot be restored automatically afterwards; you would have to contact Babilim support at %s to get it back."
msgstr "Jika ini aktif, pencopotan juga akan menghapus identitas situs ini. Lisensi berbayar yang terhubung ke situs ini tidak dapat dipulihkan secara otomatis setelahnya; Anda harus menghubungi dukungan Babilim di %s untuk mendapatkannya kembali."

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1665
#, php-format
msgid "Babilim is set to erase this site's identity when the plugin is deleted. The paid license attached to this site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in the Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Babilim diatur untuk menghapus identitas situs ini saat plugin dihapus. Lisensi berbayar yang terhubung ke situs ini tidak dapat dipulihkan secara otomatis; Anda harus menghubungi dukungan Babilim di %s. Untuk mempertahankan identitas, tekan Batal, hapus centang \"Hapus semua data Babilim saat dicopot\" di pengaturan Babilim, lalu nonaktifkan lagi. Tetap nonaktifkan?"

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1709
#, php-format
msgid "This network has too many sites to check them one by one, and some of them may be set to erase their Babilim identity when the plugin is deleted. The paid license attached to such a site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "Jaringan ini memiliki terlalu banyak situs untuk diperiksa satu per satu, dan beberapa di antaranya mungkin diatur untuk menghapus identitas Babilim mereka saat plugin dihapus. Lisensi berbayar yang terhubung ke situs semacam itu tidak dapat dipulihkan secara otomatis; Anda harus menghubungi dukungan Babilim di %s. Untuk mempertahankan identitas tersebut, tekan Batal, hapus centang \"Hapus semua data Babilim saat dicopot\" di pengaturan Babilim setiap situs, lalu nonaktifkan lagi. Tetap nonaktifkan?"

#: admin/class-babilim-admin.php:1798
msgid "Open Babilim settings"
msgstr "Buka pengaturan Babilim"

#: admin/class-babilim-admin.php:1803
msgid "Babilim could not verify this site, so nothing is downloaded or installed."
msgstr "Babilim tidak dapat memverifikasi situs ini, jadi tidak ada yang diunduh atau dipasang."

#: admin/class-babilim-admin.php:1815
msgid "The service could not reach your site. A firewall, security plugin or host rule is probably blocking the request; please allow requests to /wp-json/babilim/v1/challenge."
msgstr "Layanan tidak dapat menjangkau situs Anda. Kemungkinan firewall, plugin keamanan, atau aturan host memblokir permintaan ini; harap izinkan permintaan ke /wp-json/babilim/v1/challenge."

#: admin/class-babilim-admin.php:1817
msgid "Your site took too long to answer. Please try again later, and check that your host is not too slow or overloaded."
msgstr "Situs Anda terlalu lama merespons. Silakan coba lagi nanti, dan pastikan host Anda tidak terlalu lambat atau kelebihan beban."

#: admin/class-babilim-admin.php:1819
msgid "Your site answered, but not with what was expected. The REST API may be rewritten by another plugin, or that endpoint may be cached; please exclude /wp-json/babilim/v1/challenge from caching and rewriting."
msgstr "Situs Anda merespons, tetapi tidak dengan jawaban yang diharapkan. REST API mungkin ditulis ulang oleh plugin lain, atau endpoint tersebut mungkin di-cache; harap kecualikan /wp-json/babilim/v1/challenge dari caching dan penulisan ulang."

#: admin/class-babilim-admin.php:1821
msgid "Please check that your site can be reached from the internet, then try again."
msgstr "Pastikan situs Anda dapat diakses dari internet, lalu coba lagi."

#: admin/class-babilim-admin.php:1844
msgid "Re-verify"
msgstr "Verifikasi ulang"

#. translators: 1: number of components left out, 2: number of locales left out.
#: admin/class-babilim-admin.php:1865
#, php-format
msgid "This site is over the size the service accepts in one sync, so some items were left out: %1$d components and %2$d locales."
msgstr "Situs ini melebihi ukuran yang diterima layanan dalam satu kali sinkronisasi, sehingga beberapa item dilewati: %1$d komponen dan %2$d lokal."

#: admin/class-babilim-admin.php:1894
msgid "This site is verified."
msgstr "Situs ini telah diverifikasi."

#: admin/class-babilim-admin.php:1907
msgid "Registration restarted."
msgstr "Pendaftaran dimulai ulang."

#: admin/class-babilim-admin.php:1928
#: admin/class-babilim-admin.php:1994
msgid "Sync complete."
msgstr "Sinkronisasi selesai."

#: admin/class-babilim-admin.php:1955
msgid "Babilim is enabling and checking this site… Reload this page or wait for the scheduled check to finish."
msgstr "Babilim sedang mengaktifkan dan memeriksa situs ini… Muat ulang halaman ini atau tunggu pemeriksaan terjadwal selesai."

#. translators: 1: short name of the step that failed, 2: the message for that failure.
#: admin/class-babilim-admin.php:1960
#, php-format
msgid "Babilim could not finish enabling (%1$s): %2$s"
msgstr "Babilim tidak dapat menyelesaikan pengaktifan (%1$s): %2$s"

#: admin/class-babilim-admin.php:1965
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "Host yang hanya melayani satu permintaan PHP pada satu waktu tidak dapat menyelesaikan langkah ini."

#: admin/class-babilim-admin.php:2062
msgid "Babilim is disabled. Nothing more is sent; translations already installed keep working."
msgstr "Babilim dinonaktifkan. Tidak ada lagi yang dikirim; terjemahan yang sudah terpasang tetap berfungsi."

#: admin/class-babilim-admin.php:2084
msgid "Supplementary translation index rebuilt."
msgstr "Indeks terjemahan tambahan dibangun ulang."

#: admin/class-babilim-admin.php:2136
msgid "Automatic installs are now off; turn them on again in the settings if you want them."
msgstr "Pemasangan otomatis kini nonaktif; aktifkan lagi di pengaturan jika Anda menginginkannya."

#: admin/class-babilim-admin.php:2455
msgid "Babilim finds the plugins and themes on this site that have no translation for your language and installs one for each."
msgstr "Babilim menemukan plugin dan tema di situs ini yang belum memiliki terjemahan untuk bahasa Anda, lalu memasang satu terjemahan untuk masing-masing."

#. translators: %s: a list of language names, joined the way the language joins lists.
#: admin/class-babilim-admin.php:2463
#, php-format
msgid "Languages found on this site: %s."
msgstr "Bahasa yang ditemukan di situs ini: %s."

#: admin/class-babilim-admin.php:2468
msgid "Available translations can be installed with one click, and missing ones can be requested. After that, new translations and updates are installed automatically (on the free plan, only for plugins and themes that already use a free slot)."
msgstr "Terjemahan yang tersedia dapat dipasang dengan satu klik, dan yang belum ada dapat diminta. Setelah itu, terjemahan baru dan pembaruan dipasang secara otomatis (pada paket gratis, hanya untuk plugin dan tema yang sudah menggunakan slot gratis)."

#: admin/class-babilim-admin.php:2469
msgid "The free plan covers a limited number of plugins and themes; your exact quota is shown in Settings after you enable Babilim."
msgstr "Paket gratis mencakup sejumlah terbatas plugin dan tema; kuota pastinya ditampilkan di Pengaturan setelah Anda mengaktifkan Babilim."

#: admin/class-babilim-admin.php:2470
msgid "What is sent when you enable Babilim"
msgstr "Apa yang dikirim saat Anda mengaktifkan Babilim"

#: admin/class-babilim-admin.php:2474
msgid "Enabling…"
msgstr "Mengaktifkan…"

#: admin/class-babilim-admin.php:2474
msgid "Enable Babilim"
msgstr "Aktifkan Babilim"

#: admin/class-babilim-admin.php:2475
msgid "By clicking Enable, you agree to send the information listed above to Babilim."
msgstr "Dengan mengklik Aktifkan, Anda setuju untuk mengirim informasi yang tercantum di atas ke Babilim."

#: admin/class-babilim-admin.php:2509
#: admin/class-babilim-admin.php:2551
#: admin/class-babilim-admin.php:3831
msgid "Check again now"
msgstr "Periksa lagi sekarang"

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:2544
#, php-format
msgid "Babilim is enabling and checking this site… (last attempt: %s)"
msgstr "Babilim sedang mengaktifkan dan memeriksa situs ini… (percobaan terakhir: %s)"

#: admin/class-babilim-admin.php:2548
msgid "Check again"
msgstr "Periksa lagi"

#: admin/class-babilim-admin.php:2561
msgid "No components synced yet."
msgstr "Belum ada komponen yang disinkronkan."

#. translators: %s: the bulk action (download, update or request).
#: admin/class-babilim-admin.php:2597
#, php-format
msgid "Bulk %s:"
msgstr "%s massal:"

#. translators: 1: the "Bulk <action>:" lead-in.
#: admin/class-babilim-admin.php:2600
#, php-format
msgid "%1$s nothing to do."
msgstr "%1$s tidak ada yang perlu dilakukan."

#. translators: 1: the "Bulk <action>:" lead-in, 2: the counts, already joined into a list.
#: admin/class-babilim-admin.php:2603
#, php-format
msgid "%1$s %2$s."
msgstr "%1$s %2$s."

#. translators: 1: component name, 2: language name, 3: why the action failed.
#: admin/class-babilim-admin.php:2638
#, php-format
msgid "%1$s (%2$s): %3$s"
msgstr "%1$s (%2$s): %3$s"

#: admin/class-babilim-admin.php:2673
msgid "Continuing…"
msgstr "Melanjutkan…"

#. translators: %d: how many operations are left.
#: admin/class-babilim-admin.php:2676
#, php-format
msgid "Continue next batch (%d left)"
msgstr "Lanjutkan batch berikutnya (sisa %d)"

#: admin/class-babilim-admin.php:2726
msgid "Search components"
msgstr "Cari komponen"

#. translators: %s: link to the Settings page, with the text "Settings".
#: admin/class-babilim-admin.php:2733
#, php-format
msgid "These are the languages this site uses. You can change them in %s."
msgstr "Ini adalah bahasa yang digunakan situs ini. Anda dapat mengubahnya di %s."

#: admin/class-babilim-admin.php:2752
msgid "Upload this component?"
msgstr "Unggah komponen ini?"

#: admin/class-babilim-admin.php:2754
#: includes/class-babilim-upload.php:91
msgid "There is no upload waiting for confirmation."
msgstr "Tidak ada unggahan yang menunggu konfirmasi."

#: admin/class-babilim-admin.php:2754
#: admin/class-babilim-admin.php:2781
msgid "Back"
msgstr "Kembali"

#: admin/class-babilim-admin.php:2758
msgid "To translate this component, Babilim needs its source."
msgstr "Untuk menerjemahkan komponen ini, Babilim memerlukan sumbernya."

#. translators: 1: plugin or theme name, 2: its version number.
#: admin/class-babilim-admin.php:2760
#, php-format
msgid "The entire plugin or theme directory of %1$s (version %2$s) will be uploaded to Babilim."
msgstr "Seluruh direktori plugin atau tema %1$s (versi %2$s) akan diunggah ke Babilim."

#: admin/class-babilim-admin.php:2761
msgid "If that directory contains keys, logs or customer data, they will be uploaded too. The service removes common sensitive files (configuration, environment, database dumps, logs, keys) but cannot guarantee it finds everything."
msgstr "Jika direktori tersebut berisi kunci, log, atau data pelanggan, semuanya akan ikut diunggah. Layanan ini menghapus file sensitif yang umum (konfigurasi, environment, dump database, log, kunci), tetapi tidak dapat menjamin semuanya ditemukan."

#: admin/class-babilim-admin.php:2762
msgid "The upload is kept until you ask Babilim to delete it."
msgstr "Unggahan disimpan sampai Anda meminta Babilim untuk menghapusnya."

#: admin/class-babilim-admin.php:2763
msgid "It is stored by the service's hosting provider and processed by AI models to produce the translation."
msgstr "Unggahan disimpan oleh penyedia hosting layanan dan diproses oleh model AI untuk menghasilkan terjemahan."

#: admin/class-babilim-admin.php:2764
msgid "The original text and the translations made from it will be provided to other sites that install the same version."
msgstr "Teks asli dan terjemahan yang dibuat darinya akan diberikan kepada situs lain yang memasang versi yang sama."

#: admin/class-babilim-admin.php:2765
msgid "By continuing you confirm that you have the right to upload this component."
msgstr "Dengan melanjutkan, Anda menyatakan bahwa Anda berhak mengunggah komponen ini."

#: admin/class-babilim-admin.php:2766
msgid "Upload and request"
msgstr "Unggah dan minta"

#: admin/class-babilim-admin.php:2766
msgid "Uploading…"
msgstr "Mengunggah…"

#: admin/class-babilim-admin.php:2767
#: admin/class-babilim-admin.php:2786
#: admin/class-babilim-admin.php:2823
#: admin/class-babilim-admin.php:2880
msgid "Cancel"
msgstr "Batal"

#: admin/class-babilim-admin.php:2779
msgid "Uploading"
msgstr "Mengunggah"

#: admin/class-babilim-admin.php:2781
#: includes/class-babilim-upload.php:133
msgid "There is no upload in progress."
msgstr "Tidak ada unggahan yang sedang berlangsung."

#. translators: 1: number of the part being sent, 2: total number of parts.
#: admin/class-babilim-admin.php:2784
#, php-format
msgid "Uploading part %1$d of %2$d…"
msgstr "Mengunggah bagian %1$d dari %2$d…"

#: admin/class-babilim-admin.php:2785
msgid "Continue"
msgstr "Lanjutkan"

#: admin/class-babilim-admin.php:2825
msgid "Confirm"
msgstr "Konfirmasi"

#: admin/class-babilim-admin.php:2828
#: admin/class-babilim-admin.php:2892
#: admin/class-babilim-translations-table.php:691
msgid "Remove"
msgstr "Hapus"

#: admin/class-babilim-admin.php:2832
#: admin/class-babilim-admin.php:2891
#: admin/class-babilim-translations-table.php:690
msgid "Roll back"
msgstr "Kembalikan"

#: admin/class-babilim-admin.php:2835
msgid "Nothing to confirm."
msgstr "Tidak ada yang perlu dikonfirmasi."

#: admin/class-babilim-admin.php:2881
msgid "Choose a language"
msgstr "Pilih bahasa"

#: admin/class-babilim-admin.php:2893
#: admin/class-babilim-translations-table.php:692
msgid "Roll back and report"
msgstr "Kembalikan dan laporkan"

#: admin/class-babilim-admin.php:2894
#: admin/class-babilim-admin.php:3906
#: admin/class-babilim-translations-table.php:693
msgid "Report a problem"
msgstr "Laporkan masalah"

#: admin/class-babilim-admin.php:2898
msgid "Nothing to choose."
msgstr "Tidak ada yang dapat dipilih."

#. translators: 1: action name such as Remove, 2: component name.
#: admin/class-babilim-admin.php:2904
#, php-format
msgid "%1$s: %2$s. Choose the language."
msgstr "%1$s: %2$s. Pilih bahasa."

#: admin/class-babilim-admin.php:3050
msgid "Supplementary translations"
msgstr "Terjemahan tambahan"

