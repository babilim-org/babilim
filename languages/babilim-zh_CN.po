msgstr "批量更新:"

#: admin/class-babilim-admin.php:2785
msgid "Bulk request:"
msgstr "批量请求:"

#: admin/class-babilim-admin.php:2798
msgid "per day"
msgstr "每天"

#: admin/class-babilim-admin.php:2812
msgid "Wrong meaning"
msgstr "含义错误"

#: admin/class-babilim-admin.php:2814
msgid "Wrong term"
msgstr "术语错误"

#: admin/class-babilim-admin.php:2816
msgid "Broken placeholder"
msgstr "占位符已损坏"

#: admin/class-babilim-admin.php:2818
msgid "Wrong for this context"
msgstr "不适用于此上下文"

#: admin/class-babilim-admin.php:2820
msgid "Wrong plural form"
msgstr "复数形式错误"

#: admin/class-babilim-admin.php:2822
