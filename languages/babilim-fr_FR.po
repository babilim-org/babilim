msgstr "Babilim n'a pas pu terminer l'activation (%1$s) : %2$s"

#: admin/class-babilim-admin.php:3792
msgid "Babilim could not finish verifying this site (the service could not reach it back). Registration is paused."
msgstr "Babilim n’a pas pu terminer la vérification de ce site (le service n’a pas pu le joindre en retour). L’enregistrement est suspendu."

#: includes/class-babilim-site.php:434
