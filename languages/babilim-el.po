#. translators: 1: number of components, 2: number of languages, 3: number of check batches needed, 4: the most batches one run can send.
#: includes/class-babilim-site.php:911
#, php-format
msgid "This site has %1$d components across %2$d languages, which needs %3$d check batches; Babilim can handle at most %4$d per run. Reduce the managed languages in Settings or deactivate unused plugins and themes, then press Check again now."
msgstr "Αυτός ο ιστότοπος έχει %1$d στοιχεία σε %2$d γλώσσες, γεγονός που απαιτεί %3$d παρτίδες ελέγχου· το Babilim μπορεί να χειριστεί το πολύ %4$d ανά εκτέλεση. Μειώστε τις διαχειριζόμενες γλώσσες στις Ρυθμίσεις ή απενεργοποιήστε αχρησιμοποίητα πρόσθετα και θέματα και μετά πατήστε Έλεγχος ξανά."

#: admin/class-babilim-admin.php:4612
msgid "This site has no purchase to show a code for."
msgstr "Αυτός ο ιστότοπος δεν έχει αγορά για την οποία να εμφανιστεί κωδικός."

#: admin/class-babilim-admin.php:3974
msgid "This site is already licensed. Reload the page."
msgstr "Αυτός ο ιστότοπος έχει ήδη άδεια. Επαναφορτώστε τη σελίδα."

#: admin/class-babilim-admin.php:3966
#: admin/class-babilim-admin.php:4564
#: admin/class-babilim-admin.php:4604
#: includes/class-babilim-site.php:857
#: includes/class-babilim-sync-installer.php:405
