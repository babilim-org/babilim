#. translators: 1: when the guard tripped, 2: why.
#: admin/class-babilim-admin.php:4830
#, php-format
msgid "A cleanup was paused on %1$s: %2$s. Nothing was deleted."
msgstr "Ένας καθαρισμός τέθηκε σε παύση στις %1$s: %2$s. Δεν διαγράφηκε τίποτα."

#: includes/class-babilim-packager.php:125
msgid "A file in the component could not be read, so it was not packaged."
msgstr "Ένα αρχείο του στοιχείου δεν ήταν δυνατό να διαβαστεί, γι' αυτό δεν συμπεριλήφθηκε στο πακέτο."

#: admin/class-babilim-admin.php:2386
msgid "A host that serves only one PHP request at a time cannot complete this step."
msgstr "Ένας διακομιστής που εξυπηρετεί μόνο ένα αίτημα PHP τη φορά δεν μπορεί να ολοκληρώσει αυτό το βήμα."

#: includes/class-babilim-upload.php:293
msgid "A part of the upload kept failing, so the upload was cancelled."
msgstr "Ένα τμήμα της μεταφόρτωσης συνέχισε να αποτυγχάνει, γι' αυτό η μεταφόρτωση ακυρώθηκε."

#: admin/class-babilim-admin.php:1377
msgid "A translation cannot be requested for that locale on this site right now."
msgstr "Δεν είναι δυνατή αυτή τη στιγμή η αίτηση μετάφρασης για αυτές τις τοπικές ρυθμίσεις σε αυτόν τον ιστότοπο."

#. translators: 1: when the conflicting write happened, 2: which part of the index it was for.
#: admin/class-babilim-admin.php:4862
#, php-format
msgid "A translation-index write conflicted with another request on %1$s (%2$s) and was not applied; the most recent version was kept."
msgstr "Μια εγγραφή στο ευρετήριο μεταφράσεων συγκρούστηκε με άλλο αίτημα στις %1$s (%2$s) και δεν εφαρμόστηκε· διατηρήθηκε η πιο πρόσφατη έκδοση."

#. translators: 1: when the write failed, 2: which part of the index it was for, 3: a short technical reason code.
#: admin/class-babilim-admin.php:4875
#, php-format
msgid "A translation-index write on %1$s (%2$s) could not be completed and was not applied (%3$s)."
msgstr "Μια εγγραφή στο ευρετήριο μεταφράσεων στις %1$s (%2$s) δεν ολοκληρώθηκε και δεν εφαρμόστηκε (%3$s)."

