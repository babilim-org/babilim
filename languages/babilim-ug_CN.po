msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "تور بېكىتىڭىزدە ئورنىتىلغان قىستۇرمىلار ۋە ئۆرنەكلەرنىڭ كەم تەرجىمىلىرىنى تولدۇرىدۇ."

#: admin/class-babilim-admin.php:1274
msgid "That upload screen was out of date: a different upload has been prepared since. Nothing was sent. Review the current one from the Translations list."
msgstr "بۇ يوللاش ئېكرانى ۋاقتى ئۆتكەن: ئۇنىڭدىن كېيىن باشقا بىر يوللاش تەييارلانغان. ھېچنېمە ئەۋەتىلمىدى. نۆۋەتتىكىسىنى تەرجىمە تىزىمliكىدىن كۆرۈپ چىقىڭ."

#: admin/class-babilim-admin.php:3067
msgid "The free service plan gives each site a limited number of slots for plugins and themes; the slots in use are shown in Settings after you enable Babilim."
msgstr "ھەقسىز مۇلازىمەت پىلانى ھەر بىر تور بېكەتكە قىستۇرما ۋە ئۆرنەكلەر ئۈچۈن چەكلىك ساندىكى ئورۇن بېرىدۇ؛ ئىشلىتىلىۋاتقان ئورۇنلار Babilim نى قوزغاتقاندىن كېيىن تەڭشەكلەردە كۆرسىتىلىدۇ."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:62
#, php-format
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site (the limit is %1$d for themes and %2$d for plugins), unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "تەرجىمە تەلەپ قىلسىڭىز، بۇ قىستۇرما ياكى ئۆرنەك بۇ تور بېكەتنىڭ ھەقسىز مۇلازىمەت پىلانىدىكى ئورۇنلارنىڭ بىرىگە ئورۇنلاشتۇرىلىدۇ (چەك: ئۆرنەكلەر ئۈچۈن %1$d، قىستۇرمىلار ئۈچۈن %2$d)، ئەگەر ئۇنىڭدا ئورۇن بولمىسا. ئورۇن ئىشلىتىلگەن ھالەتتە قالىدۇ، تەرجىمە مەغلۇپ بولسىمۇ ئورۇن بىكار قىلىنمايدۇ."

#: admin/class-babilim-translations-table.php:67
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site, unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "تەرجىمە تەلەپ قىلسىڭىز، بۇ قىستۇرما ياكى ئۆرنەك بۇ تور بېكەتنىڭ ھەقسىز مۇلازىمەت پىلانىدىكى ئورۇنلارنىڭ بىرىگە ئورۇنلاشتۇرىلىدۇ، ئەگەر ئۇنىڭدا ئورۇن بولمىسا. ئورۇن ئىشلىتىلگەن ھالەتتە قالىدۇ، تەرجىمە مەغلۇپ بولسىمۇ ئورۇن بىكار قىلىنمايدۇ."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:80
#, php-format
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one (the limit is %1$d for themes and %2$d for plugins). A slot stays used, and a failed translation does not free it. Continue?"
msgstr "ئەگەر بۇ قىستۇرما ياكى ئۆرنەك بۇ تور بېكەتنىڭ ھەقسىز مۇلازىمەت پىلانىدىكى ئورۇنلارنىڭ بىرىدە تېخى بولمىسا، تەرجىمە تەلەپ قىلىش ئۇنى بىر ئورۇنغا ئورۇنلاشتۇرىدۇ (چەك: ئۆرنەكلەر ئۈچۈن %1$d، قىستۇرمىلار ئۈچۈن %2$d). ئورۇن ئىشلىتىلگەن ھالەتتە قالىدۇ، تەرجىمە مەغلۇپ بولسىمۇ ئورۇن بىكار قىلىنمايدۇ. داۋاملاشتۇرامسىز؟"

#: admin/class-babilim-translations-table.php:85
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one. A slot stays used, and a failed translation does not free it. Continue?"
msgstr "ئەگەر بۇ قىستۇرما ياكى ئۆرنەك بۇ تور بېكەتنىڭ ھەقسىز مۇلازىمەت پىلانىدىكى ئورۇنلارنىڭ بىرىدە تېخى بولمىسا، تەرجىمە تەلەپ قىلىش ئۇنى بىر ئورۇنغا ئورۇنلاشتۇرىدۇ. ئورۇن ئىشلىتىلگەن ھالەتتە قالىدۇ، تەرجىمە مەغلۇپ بولسىمۇ ئورۇن بىكار قىلىنمايدۇ. داۋاملاشتۇرامسىز؟"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1974
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "بۇ كۆپ تور بېكەتلىك تورداتىكى %1$d تور بېكەت قىستۇرما ئۆچۈرۈلگەندە ئۆزىنىڭ Babilim كىملىكىنى ئۆچۈرۈۋېتىشكە تەڭشەلگەن. ئۇنىڭدىن كېيىن ئۇ تور بېكەتكە باغلانغان ھەقلىق ئىجازەتنامىنى ئاپتوماتىك ئەسلىگە كەلتۈرگىلى بولمايدۇ؛ ئۇنى قايتۇرۇۋېلىش ئۈچۈن Babilim قوللىشى بىلەن %2$s ئارقىلىق ئالاقىلىشىشىڭىز كېرەك. كىملىكنى ساقلاپ قېلىش ئۈچۈن «ۋاز كېچىش» نى چېكىڭ، ئۇ تور بېكەتنىڭ Babilim تەڭشەكلىرىدىكى «ئورنىتىلمىغاندا Babilim نىڭ بارلىق سانلىق مەلۇماتلىرىنى ئۆچۈرۈش» تاللانمىسىدىكى بەلگىنى ئېلىۋېتىڭ، ئاندىن قايتا توختىتىڭ. بەرىبىر توختىتامسىز؟"
msgstr[1] "بۇ كۆپ تور بېكەتلىك تورداتىكى %1$d تور بېكەت قىستۇرما ئۆچۈرۈلگەندە ئۆزىنىڭ Babilim كىملىكىنى ئۆچۈرۈۋېتىشكە تەڭشەلگەن. ئۇنىڭدىن كېيىن ئۇ تور بېكەتلەرگە باغلانغان ھەقلىق ئىجازەتنامىنى ئاپتوماتىك ئەسلىگە كەلتۈرگىلى بولمايدۇ؛ ئۇنى قايتۇرۇۋېلىش ئۈچۈن Babilim قوللىشى بىلەن %2$s ئارقىلىق ئالاقىلىشىشىڭىز كېرەك. كىملىكلەرنى ساقلاپ قېلىش ئۈچۈن «ۋاز كېچىش» نى چېكىڭ، ھەر بىر تور بېكەتنىڭ Babilim تەڭشەكلىرىدىكى «ئورنىتىلمىغاندا Babilim نىڭ بارلىق سانلىق مەلۇماتلىرىنى ئۆچۈرۈش» تاللانمىسىدىكى بەلگىنى ئېلىۋېتىڭ، ئاندىن قايتا توختىتىڭ. بەرىبىر توختىتامسىز؟"

