msgid "Babilim"
msgstr "Babilim"

#. Description of the plugin
#: babilim.php
msgid "Fills in missing translations for the plugins and themes already installed on your site."
msgstr "Dopĺňa chýbajúce preklady pre pluginy a témy, ktoré sú už nainštalované na vašej stránke."

#: admin/class-babilim-admin.php:1274
msgid "That upload screen was out of date: a different upload has been prepared since. Nothing was sent. Review the current one from the Translations list."
msgstr "Táto obrazovka nahrávania je zastaraná: odvtedy sa pripravilo iné nahrávanie. Nič sa neodoslalo. Aktuálne nahrávanie skontrolujte zo zoznamu Translations."

#: admin/class-babilim-admin.php:3067
msgid "The free service plan gives each site a limited number of slots for plugins and themes; the slots in use are shown in Settings after you enable Babilim."
msgstr "Bezplatný servisný plán poskytuje každej stránke obmedzený počet slotov pre pluginy a témy; využité sloty sa zobrazia v Nastaveniach po aktivácii Babilim."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:62
#, php-format
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site (the limit is %1$d for themes and %2$d for plugins), unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Požiadanie o preklad zaradí tento plugin alebo tému do jedného zo slotov bezplatného servisného plánu pre túto stránku (limit je %1$d pre témy a %2$d pre pluginy), ak ho ešte nemá. Slot zostáva využitý a neúspešný preklad ho neuvoľní."

#: admin/class-babilim-translations-table.php:67
msgid "Requesting a translation puts this plugin or theme on one of the free service plan's slots for this site, unless it already has one. A slot stays used, and a failed translation does not free it."
msgstr "Požiadanie o preklad zaradí tento plugin alebo tému do jedného zo slotov bezplatného servisného plánu pre túto stránku, ak ho ešte nemá. Slot zostáva využitý a neúspešný preklad ho neuvoľní."

#. translators: 1: the free service plan's theme slot limit, 2: its plugin slot limit (both numbers come from the service).
#: admin/class-babilim-translations-table.php:80
#, php-format
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one (the limit is %1$d for themes and %2$d for plugins). A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Ak tento plugin alebo téma ešte nie je v jednom zo slotov bezplatného servisného plánu pre túto stránku, požiadanie o preklad ho do jedného zaradí (limit je %1$d pre témy a %2$d pre pluginy). Slot zostáva využitý a neúspešný preklad ho neuvoľní. Pokračovať?"

#: admin/class-babilim-translations-table.php:85
msgid "If this plugin or theme is not on one of the free service plan's slots for this site yet, requesting a translation puts it on one. A slot stays used, and a failed translation does not free it. Continue?"
msgstr "Ak tento plugin alebo téma ešte nie je v jednom zo slotov bezplatného servisného plánu pre túto stránku, požiadanie o preklad ho do jedného zaradí. Slot zostáva využitý a neúspešný preklad ho neuvoľní. Pokračovať?"

#. translators: 1: number of sites on the network that erase their Babilim identity when the plugin is deleted. 2: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1974
#, php-format
msgid "%1$d site on this network is set to erase its Babilim identity when the plugin is deleted. The paid license attached to that site could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identity, press Cancel, untick \"Delete all Babilim data on uninstall\" in that site's Babilim settings, and deactivate again. Deactivate anyway?"
msgid_plural "%1$d sites on this network are set to erase their Babilim identity when the plugin is deleted. The paid license attached to those sites could then not be restored automatically; you would have to contact Babilim support at %2$s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr[0] "%1$d stránka v tejto sieti je nastavená tak, že pri odstránení pluginu odstráni svoju identitu Babilim. Platenú licenciu pripojenú k tejto stránke by potom nebolo možné automaticky obnoviť; museli by ste sa obrátiť na podporu Babilim na %2$s. Ak chcete identitu zachovať, stlačte Zrušiť, v nastaveniach Babilim tejto stránky zrušte začiarknutie voľby \"Pri odinštalovaní odstrániť všetky údaje Babilim\" a deaktivujte znova. Napriek tomu deaktivovať?"
msgstr[1] "%1$d stránky v tejto sieti sú nastavené tak, že pri odstránení pluginu odstránia svoju identitu Babilim. Platenú licenciu pripojenú k týmto stránkam by potom nebolo možné automaticky obnoviť; museli by ste sa obrátiť na podporu Babilim na %2$s. Ak chcete identity zachovať, stlačte Zrušiť, v nastaveniach Babilim každej stránky zrušte začiarknutie voľby \"Pri odinštalovaní odstrániť všetky údaje Babilim\" a deaktivujte znova. Napriek tomu deaktivovať?"
msgstr[2] "%1$d stránok v tejto sieti je nastavených tak, že pri odstránení pluginu odstránia svoju identitu Babilim. Platenú licenciu pripojenú k týmto stránkam by potom nebolo možné automaticky obnoviť; museli by ste sa obrátiť na podporu Babilim na %2$s. Ak chcete identity zachovať, stlačte Zrušiť, v nastaveniach Babilim každej stránky zrušte začiarknutie voľby \"Pri odinštalovaní odstrániť všetky údaje Babilim\" a deaktivujte znova. Napriek tomu deaktivovať?"

