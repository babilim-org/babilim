#: includes/class-babilim-installer.php:483
msgid "manifest.json is missing or has an invalid 'build_no'."
msgstr "manifest.json കാണുന്നില്ല അല്ലെങ്കിൽ അതിൽ 'build_no' അസാധുവാണ്."

