#. translators: %s: link to the Settings page, with the text "Settings".
#: admin/class-babilim-admin.php:3399
#, php-format
msgid "These are the languages this site uses. You can change them in %s."
msgstr "འདི་དག་ནི་དྲ་ཚིགས་འདིས་སྤྱོད་བཞིན་པའི་སྐད་ཡིག་ཡིན། ཁྱེད་ཀྱིས་%sནང་བསྒྱུར་ཆོག"

#: admin/class-babilim-admin.php:4260
msgid "These fields will be sent:"
msgstr "གཤམ་གྱི་གནས་སྡུད་ས་མིག་རྣམས་བསྐུར་རྒྱུ་ཡིན།"

#: admin/class-babilim-admin.php:1452
msgid "This build is not one this site currently knows about for this component/locale."
msgstr "བཟོ་རིམ་འདི་ཆ་ཤས་/སྐད་ཡིག་འདིའི་ཆེད་དུ་དྲ་ཚིགས་འདིས་ད་ལྟ་ཤེས་པ་ཞིག་མ་ཡིན།"

#: admin/class-babilim-admin.php:1364
msgid "This component does not declare a version number, so a translation cannot be requested for it."
msgstr "ཆ་ཤས་འདིས་པར་གཞིའི་གྲངས་ཨང་གསལ་བཀོད་བྱས་མེད་པས། དེའི་སྐད་སྒྱུར་ཞུ་མི་ཐུབ།"

#: includes/class-babilim-upload.php:112
msgid "This component is larger than the service accepts, so it cannot be uploaded."
msgstr "ཆ་ཤས་འདིའི་ཆེ་ཆུང་ནི་ཞབས་ཞུས་དང་ལེན་བྱེད་ཐུབ་པའི་ཚད་ལས་ཆེ་བས་ཡར་སྐྱེལ་བྱེད་མི་ཐུབ།"

#: admin/class-babilim-admin.php:1205
msgid "This component was already uploaded. Babilim is checking it now."
msgstr "ཆ་ཤས་འདི་སྔོན་ཆད་ཡར་འཇུག་བྱས་ཟིན། Babilim གྱིས་ད་ལྟ་ཞིབ་བཤེར་བྱེད་བཞིན་འདུག"

#. translators: %d: the most characters a version number may have.
#: admin/class-babilim-admin.php:1371
#, php-format
msgid "This component's version number is longer than %d characters, which Babilim cannot handle, so a translation cannot be requested for it."
msgstr "ཆ་ཤས་འདིའི་པར་གཞིའི་གྲངས་ཨང་གི་རིང་ཚད་ཡིག་འབྲུ་ %d ལས་བརྒལ་བས། Babilim གྱིས་དེ་ལ་ལས་སྣོན་བྱེད་མི་ཐུབ། དེའི་ཕྱིར་དེའི་སྐད་སྒྱུར་ཞུ་མི་ཐུབ།"

#: admin/class-babilim-admin.php:4518
msgid "This issues a new restore code and the previous one stops working. Continue?"
msgstr "འདིས་སླར་གསོའི་ཨང་རྟགས་གསར་པ་ཞིག་སྤྲོད་ཅིང་སྔོན་མ་དེ་ནུས་མེད་འགྱུར། མུ་མཐུད་དམ།"

#. translators: %s: Babilim support email address. Do not translate or change it.
#: admin/class-babilim-admin.php:1993
#, php-format
msgid "This network has too many sites to check them one by one, and some of them may be set to erase their Babilim identity when the plugin is deleted. The paid license attached to such a site could then not be restored automatically; you would have to contact Babilim support at %s. To keep the identities, press Cancel, untick \"Delete all Babilim data on uninstall\" in each site's Babilim settings, and deactivate again. Deactivate anyway?"
msgstr "དྲ་རྒྱ་འདིའི་ནང་གི་དྲ་ཚིགས་མང་དྲགས་པས་གཅིག་རེ་བཞིན་བརྟག་དཔྱད་བྱེད་མི་ཐུབ། དེ་ཚོའི་ནང་ནས་ཁ་ཅིག་གིས་སྒྲིག་འཇུག་བསུབ་སྐབས་རང་གི་ Babilim ངོ་རྟགས་སུབ་རྒྱུར་བཀོད་ཡོད་སྲིད། དེ་ལྟར་ན་དྲ་ཚིགས་དེ་འདྲར་སྦྲེལ་བའི་འགྲོ་སོང་ཅན་གྱི་ཆོག་མཆན་རང་འགུལ་གྱིས་སླར་གསོ་བྱེད་མི་ཐུབ། སླར་ལེན་འདོད་ན་ Babilim རོགས་རམ་ %s ལ་འབྲེལ་བ་བྱེད་དགོས། ངོ་རྟགས་ཉར་ཚགས་བྱེད་ན། “Cancel” ལ་མནན་ནས། དྲ་ཚིགས་རེ་རེའི་ Babilim སྒྲིག་འགོད་ནང་ “སྒྲིག་འཇུག་བསུབ་སྐབས་ Babilim གྱི་གཞི་གྲངས་ཐམས་ཅད་སུབ།” གྱི་རྟགས་བསུབས་ཏེ། སྒྲིག་འཇུག་དེ་ཡང་བསྐྱར་མི་སྤྱོད་པར་བཞག། ཡིན་ནའང་མི་སྤྱོད་པར་བཞག་གམ།"

#: includes/class-babilim-consent.php:87
msgid "This plugin's own version, so the service can tell you to update it if it's too old to talk to."
msgstr "ཕྱི་སྣོན་འདི་རང་གི་པར་གཞི། པར་གཞི་དེ་རྙིང་དྲགས་ནས་ཞབས་ཞུ་དང་འབྲེལ་མཐུད་བྱེད་མི་ཐུབ་ཚེ། ཞབས་ཞུས་ཁྱེད་ལ་དེ་གསར་སྒྱུར་བྱེད་དགོས་པའི་བརྡ་ལན་སྤྲོད་ཐུབ་པའི་ཆེད་དུ།"

#: admin/class-babilim-admin.php:1438
msgid "This report does not name a valid plugin or theme and locale."
msgstr "སྙན་ཐོ་འདིའི་ནང་དུ་ནུས་ལྡན་གྱི་འཇུག་ཚན་ནམ་བཟོ་ལྟ་དང་སྐད་ཡིག་གསལ་བཀོད་བྱས་མེད།"

#: admin/class-babilim-admin.php:1467
msgid "This report does not name an installed string."
msgstr "སྙན་ཞུ་འདིར་སྒྲིག་འཇུག་བྱས་ཟིན་པའི་ཡིག་ཕྲེང་གཅིག་གི་མིང་མ་བཀོད།"

#: admin/class-babilim-admin.php:1449
msgid "This report is missing a valid build to report against."
msgstr "སྙན་ཐོ་འདིར་སྙན་ཐོ་གཏོང་བའི་ནུས་ལྡན་བཟོ་རིམ་ཞིག་མེད།"

#: admin/class-babilim-admin.php:2542
msgid "This report will be posted publicly on GitHub and may be kept by third parties."
msgstr "སྙན་ཐོ་འདི་ GitHub སྟེང་སྤྱི་སྤྱོད་དུ་བསྒྲགས་ཏེ་ཕྱོགས་གསུམ་པས་ཉར་ཚགས་བྱེད་སྲིད།"

#: admin/class-babilim-admin.php:4572
msgid "This restore code was not recognised for this site."
msgstr "སླར་གསོའི་ཨང་རྟགས་འདི་དྲ་ཚིགས་འདིའི་ཆེད་དུ་ངོས་འཛིན་མ་ཐུབ།"

#: admin/class-babilim-admin.php:3793
msgid "This site already has an active registration that can no longer be recovered automatically."
msgstr "དྲ་ཚིགས་འདིར་ནུས་ལྡན་གྱི་ཐོ་འགོད་ཡོད་ཅིང་། རང་འགུལ་གྱིས་སླར་གསོ་བྱེད་མི་ཐུབ།"

#. translators: 1: number of components, 2: number of languages, 3: number of check batches needed, 4: the most batches one run can send.
#: includes/class-babilim-site.php:911
#, php-format
msgid "This site has %1$d components across %2$d languages, which needs %3$d check batches; Babilim can handle at most %4$d per run. Reduce the managed languages in Settings or deactivate unused plugins and themes, then press Check again now."
msgstr "དྲ་ཚིགས་འདིར་སྐད་ཡིག་ %2$d ནང་ཆ་ཤས་ %1$d ཡོད་པས། ཞིབ་བཤེར་གྱི་ཚན་པ་ %3$d དགོས། Babilim གྱིས་འཁོར་སྐྱོད་ཐེངས་རེར་ཚན་པ་མང་མཐར་ %4$d ལས་སྒྲུབ་མི་ཐུབ། སྒྲིག་འགོད་ནང་དོ་དམ་བྱེད་པའི་སྐད་ཡིག་གི་གྲངས་ཉུང་དུ་གཏོང་བའམ། མི་སྤྱོད་པའི་ plugin དང་ theme རྣམས་ནུས་མེད་དུ་བཟོས་ནས། «ད་ལྟ་ཡང་བརྟག་དཔྱད་བྱེད།» ལ་མནན།"

#: admin/class-babilim-admin.php:4612
msgid "This site has no purchase to show a code for."
msgstr "དྲ་ཚིགས་འདིར་སླར་གསོའི་ཨང་རྟགས་སྟོན་རྒྱུའི་ཉོ་སྒྲུབ་མེད།"

#: admin/class-babilim-admin.php:3974
msgid "This site is already licensed. Reload the page."
msgstr "དྲ་ཚིགས་འདིར་ཆོག་མཆན་ཡོད་ཟིན། ཤོག་ངོས་བསྐྱར་ལེན་བྱ།"

#: admin/class-babilim-admin.php:3966
#: admin/class-babilim-admin.php:4564
#: admin/class-babilim-admin.php:4604
#: includes/class-babilim-site.php:857
#: includes/class-babilim-sync-installer.php:405
msgid "This site is not registered with Babilim yet."
msgstr "དྲ་ཚིགས་འདི་ Babilim ལ་ད་དུང་ཐོ་འགོད་མ་བྱས།"

#. translators: 1: number of components left out, 2: number of locales left out.
#: admin/class-babilim-admin.php:2278
#, php-format
msgid "This site is over the size the service accepts in one sync, so some items were left out: %1$d components and %2$d locales."
msgstr "དྲ་ཚིགས་འདིའི་ཆེ་ཆུང་གིས་ཞབས་ཞུའི་མ་ལག་གིས་ཐེངས་གཅིག་གི་མཉམ་སྒྲིག་ནང་ཁས་ལེན་པའི་ཚད་ལས་བརྒལ་བས། ཆ་ཤས་ %1$d དང་སྐད་ཡིག་ %2$d ཕྱིར་བཞག་སོང་།"

#: admin/class-babilim-admin.php:3870
msgid "This site is part of a multisite network, which does not install new translations automatically. Translations that are already installed are still updated."
msgstr "དྲ་ཚིགས་འདི་ནི་དྲ་ཚིགས་མང་པོའི་དྲ་རྒྱའི་ཆ་ཤས་ཡིན་པས། ཡིག་སྒྱུར་གསར་པ་རང་འགུལ་གྱིས་སྒྲིག་འཇུག་མི་བྱེད། སྒྲིག་འཇུག་བྱས་ཟིན་པ་རྣམས་ད་དུང་གསར་སྤར་བྱེད།"

#: admin/class-babilim-admin.php:2307
msgid "This site is verified."
msgstr "དྲ་ཚིགས་འདི་ར་སྤྲོད་བྱས་ཟིན།"

#: admin/class-babilim-admin.php:4576
msgid "This site must be verified first."
msgstr "དྲ་ཚིགས་འདི་ཐོག་མར་ར་སྤྲོད་བྱ་དགོས།"

#: includes/class-babilim-consent.php:72
msgid "This site's URL, so the service can verify you own it."
msgstr "དྲ་ཚིགས་འདིའི་ URL། ཞབས་ཞུ་ཡིས་ཁྱེད་རང་གི་ཡིན་པ་ར་སྤྲོད་ཐུབ་ཆེད།"

#: includes/class-babilim-site.php:1483
msgid "This site's address is too long for Babilim to register."
msgstr "དྲ་ཚིགས་འདིའི་ཁ་བྱང་ཧ་ཅང་རིང་བས་ Babilim གིས་ཐོ་འགོད་བྱེད་མི་ཐུབ།"

#: includes/class-babilim-consent.php:92
msgid "This site's configured locale."
msgstr "དྲ་ཚིགས་འདིའི་སྒྲིག་འགོད་བྱས་པའི་ locale།"

#: includes/class-babilim-consent.php:102
msgid "This site's install public key, used to prove requests genuinely come from this site. Only the public half is ever sent."
msgstr "དྲ་ཚིགས་འདིའི་སྒྲིག་འཇུག་གི་སྤྱི་སྤྱོད་ལྡེ་མིག རེ་ཞུ་རྣམས་དྲ་ཚིགས་འདི་ནས་དངོས་སུ་བྱུང་བ་ར་སྤྲོད་བྱེད་པར་བེད་སྤྱོད་བྱེད། སྤྱི་སྤྱོད་ཀྱི་ཆ་ཤས་ཁོ་ན་གཏོང་གི་ཡོད།"

