msgstr "Kini nga component mas dako kaysa gidawat sa serbisyo, mao nga dili kini ma-upload."

#: includes/class-babilim-upload.php:148
msgid "The packaged component could not be read."
msgstr "Ang na-package nga component wala mabasa."

#: includes/class-babilim-upload.php:259
