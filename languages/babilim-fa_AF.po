msgid_plural "Babilim is enabled: this site is verified and %d components were found."
msgstr[0] "Babilim فعال شد: این سایت تأیید شد و %d مؤلفه پیدا شد."
msgstr[1] "Babilim فعال شد: این سایت تأیید شد و %d مؤلفه پیدا شد."

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:3148
#, php-format
