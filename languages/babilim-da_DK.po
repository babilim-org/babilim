msgstr "Søg i komponenter"

#. translators: %s: link to the Settings page, with the text "Settings".
#: admin/class-babilim-admin.php:2959
#, php-format
msgid "These are the languages this site uses. You can change them in %s."
msgstr "Det er de sprog, dette websted bruger. Du kan ændre dem under %s."

#: admin/class-babilim-admin.php:2978
msgid "Upload this component?"
msgstr "Vil du uploade denne komponent?"

#: admin/class-babilim-admin.php:2980
#: includes/class-babilim-upload.php:96
msgid "There is no upload waiting for confirmation."
msgstr "Der er ingen upload, der venter på bekræftelse."

#: admin/class-babilim-admin.php:2980
#: admin/class-babilim-admin.php:3007
#: admin/class-babilim-admin.php:3685
msgid "Back"
msgstr "Tilbage"

#: admin/class-babilim-admin.php:2984
msgid "To translate this component, Babilim needs its source."
msgstr "For at oversætte denne komponent har Babilim brug for dens kilde."

