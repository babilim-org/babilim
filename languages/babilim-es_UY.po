msgstr "No se pudo crear el archivo del paquete."

#: includes/class-babilim-packager.php:88
msgid "No writable temporary directory is available for packaging."
msgstr "No hay ningún directorio temporal con permisos de escritura disponible para empaquetar."

#: includes/class-babilim-packager.php:99
msgid "A file in the component could not be read, so it was not packaged."
msgstr "No se pudo leer un archivo del componente, por lo que no se incluyó en el paquete."

#: includes/class-babilim-packager.php:139
msgid "Only plugins and themes can be packaged."
msgstr "Solo se pueden empaquetar plugins y temas."

#: includes/class-babilim-packager.php:144
