msgstr "Aucun téléversement n'est en attente de confirmation."

#: admin/class-babilim-admin.php:2980
#: admin/class-babilim-admin.php:3007
#: admin/class-babilim-admin.php:3685
msgid "Back"
msgstr "Retour"

#: admin/class-babilim-admin.php:2984
msgid "To translate this component, Babilim needs its source."
msgstr "Pour traduire ce composant, Babilim a besoin de sa source."

#: admin/class-babilim-admin.php:2988
msgid "The upload is kept until you ask Babilim to delete it."
msgstr "Le téléversement est conservé jusqu'à ce que vous demandiez à Babilim de le supprimer."

