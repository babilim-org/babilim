msgid_plural "Babilim is enabled: this site is verified and %d components were found."
msgstr[0] "Babilim ist aktiviert: Diese Website ist verifiziert und %d Komponente wurde gefunden."
msgstr[1] "Babilim ist aktiviert: Diese Website ist verifiziert und %d Komponenten wurden gefunden."

#. translators: %s: when the last attempt happened.
#: admin/class-babilim-admin.php:3148
