{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-reports.request.schema.json",
  "title": "POST /v1/error-reports request",
  "type": "object",
  "required": ["plugin_version", "events"],
  "additionalProperties": false,
  "properties": {
    "plugin_version": {"type": "string", "maxLength": 20, "description": "expected form MAJOR.MINOR.PATCH; the server counts a value that does not match as unknown rather than rejecting it, so this schema sets no pattern"},
    "wp_version": {"type": "string", "maxLength": 20},
    "php_version": {"type": "string", "maxLength": 20},
    "locale": {"type": "string", "maxLength": 35},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["event_id", "error_code", "action", "origin_id", "at"],
        "additionalProperties": false,
        "properties": {
          "event_id": {"type": "string", "pattern": "^[0-9a-f]{32}$", "description": "client-generated id; a repeated event_id is counted in 'ignored'"},
          "error_code": {"type": "string", "maxLength": 50, "description": "see error-catalog.json"},
          "action": {"type": "string", "maxLength": 50, "description": "see error-catalog.json"},
          "origin_id": {"type": "string", "maxLength": 80, "description": "see error-catalog.json"},
          "at": {"type": "string", "format": "date-time", "description": "RFC 3339 timestamp"}
        }
      }
    }
  }
}
