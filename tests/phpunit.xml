<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         failOnWarning="true">
  <testsuites>
    <testsuite name="unit">
      <directory suffix=".php">unit</directory>
    </testsuite>
  </testsuites>
</phpunit>
